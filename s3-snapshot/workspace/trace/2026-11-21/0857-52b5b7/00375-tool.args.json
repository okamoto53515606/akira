shell {"command": "cd /tmp/site && echo \"=== badge-new: $(grep -rl 'badge-new' --include=*.html . | wc -l) files / $(grep -rho 'badge-new' --include=*.html . | wc -l) hits ===\" && echo \"=== tl-new: $(grep -rho 'tl-new' --include=*.html . | wc -l) ===\" && echo \"=== 🆕: $(grep -rho '🆕' --include=*.html . | wc -l) ===\" && echo \"=== data/models.json badge/New ===\" && grep -o \"New [a-z]*\" data/models.json | sort | uniq -c && echo \"=== facts.json badge-new: $(grep -c 'badge-new' /workspace/data/facts.json) ===\" && echo && echo \"=== remaining 'New' word (line:ctx) ===\" && python3 - <<'PYEOF'\nimport pathlib,re\nfor p in sorted(pathlib.Path('.').rglob('*.html')):\n    for i,l in enumerate(p.read_text(encoding='utf-8').split('\\n'),1):\n        for m in re.finditer(r'(?<![A-Za-z])New(est)?(?![A-Za-z])',l):\n            print(\"%-40s L%-4d %s\"%(p,i,l[max(0,m.start()-60):m.start()+60].strip()))\nPYEOF"}