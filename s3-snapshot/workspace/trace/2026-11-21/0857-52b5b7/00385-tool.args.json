shell {"command": "cd /workspace/data && python3 -c \"\nimport json,re\nf=json.load(open('facts.json'))\ndef walk(o,path=''):\n    if isinstance(o,dict):\n        for k,v in o.items(): yield from walk(v,path+'/'+str(k))\n    elif isinstance(o,list):\n        for i,v in enumerate(o): yield from walk(v,path+'[%d]'%i)\n    elif isinstance(o,str): yield path,o\nhits=[(p,v) for p,v in walk(f) if re.search(r'(?<![A-Za-z])New(?![A-Za-z])|badge-new|🆕',v)]\nprint('facts.json remaining New/badge/🆕 hits:',len(hits))\nfor p,v in hits:\n    import re as r\n    for m in r.finditer(r'(?<![A-Za-z])New(?![A-Za-z])',v):\n        print(' ',p,'::',v[max(0,m.start()-70):m.start()+70].replace(chr(10),' '))\n\""}