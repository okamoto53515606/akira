shell {"command": "cd /workspace && python3 - <<'PYEOF'\nimport json\nfacts=json.load(open('data/facts.json'))\ncur=json.load(open('/tmp/site/data/models.json'))\nby_name={}\nfor rid,r in facts['models'].items():\n    p=r.get('price') or {}\n    if not p: continue\n    nm=p.get('name') or (r.get('names') or {}).get('ja')\n    if nm: by_name[nm]=p\ndiff=[]\nfor r in cur['models']:\n    p=by_name.get(r['name'])\n    if not p: continue\n    for a,b in (('note','note_ja'),('note_en','note_en')):\n        fv=p.get(b); cv=r.get(a)\n        if fv is not None and fv.strip() and fv!=cv:\n            diff.append((r['name'],a,repr(cv)[:60],repr(fv)[:60]))\nprint(\"rows in models.json:\",len(cur['models']),\"  candidates for note sync:\",len(diff))\nfor d in diff: print(\"  %-20s %-8s %s -> %s\"%(d[0],d[1],d[2],d[3]))\nPYEOF"}