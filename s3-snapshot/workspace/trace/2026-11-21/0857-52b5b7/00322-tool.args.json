shell {"command": "cd /tmp/site && python3 - <<'PYEOF'\nimport pathlib,re,json\ntoks=re.compile(r'(badge-new|tl-new|🆕|値下|プロモ|(?<![A-Za-z])New(?![A-Za-z])|Newest)')\ninv=[]\nfor p in sorted(pathlib.Path('.').rglob('*.html')):\n    s=p.read_text(encoding='utf-8')\n    for i,line in enumerate(s.split('\\n'),1):\n        for m in toks.finditer(line):\n            inv.append({'f':str(p),'ln':i,'tok':m.group(0),\n                        'ctx':line[max(0,m.start()-90):m.start()+90].replace('\\n',' ')})\njson.dump(inv,open('/workspace/notes/newbadge-inventory.json','w'),ensure_ascii=False,indent=1)\nprint(\"TOTAL token hits:\",len(inv))\nfrom collections import Counter\nprint(\"by token:\",Counter(x['tok'] for x in inv))\nprint(\"badge-new remaining:\",sum(1 for x in inv if x['tok']=='badge-new'))\n# per file counts split ja/en\nc=Counter()\nfor x in inv:\n    lang='en' if x['f'].startswith('en/') else 'ja'\n    c[(lang)]+= 1 if x['tok'] in ('badge-new','🆕') else 0\nprint(\"badge-new+🆕 by lang:\",dict(c))\nPYEOF\necho \"=== index.html card markers ===\" && grep -n \"cards:begin\\|cards:end\\|topcl:begin\" index.html | head"}