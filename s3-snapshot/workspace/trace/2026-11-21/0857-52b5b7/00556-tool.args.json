shell {"command": "cd /tmp/site && echo \"=== 値下げ幅・期間限定が残っているか ===\" && echo \"--- /pricing/ 値下げ/割引 を含むセル ---\" && grep -o \"値下げ[^<]\\{0,40\\}\\|割引[^<]\\{0,30\\}\\|オフ[^<]\\{0,25\\}\" pricing/index.html | sort | uniq -c | sort -rn | head -12 && echo \"--- en/pricing 同 ---\" && grep -o \"price cut[^<]\\{0,40\\}\\|discount[^<]\\{0,30\\}\\|cheaper[^<]\\{0,30\\}\" en/pricing/index.html | sort | uniq -c | head -8 && echo \"--- /gpt-5-6-pricecut/ の H1・カード ---\" && grep -o \"<h1[^>]*>[^<]*</h1>\" gpt-5-6-pricecut/index.html && grep -o \"80%[^<]\\{0,40\\}\" gpt-5-6-pricecut/index.html | head -4 && echo \"--- 期間限定（期限）残数 ja/en ---\" && echo \"ja=$(grep -rho \"まで\" pricing/index.html | wc -l) en=$(grep -rho \"until\" en/pricing/index.html | wc -l)\""}