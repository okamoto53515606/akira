shell {"command": "cd /workspace && python3 - <<'PYEOF'\nimport json,re\nf=json.load(open('data/facts.json'))\nb=f['features']['multimodal']['blocks']\nfor i,blk in enumerate(b):\n    for lang in ('ja','en'):\n        body=(blk.get('body') or {}).get(lang) or ''\n        if '追記' in body:\n            for m in re.finditer(r'追記',body):\n                print(\"[%d/%s] %s\"%(i,lang,body[max(0,m.start()-90):m.start()+50].replace('\\n',' ')))\nPYEOF"}