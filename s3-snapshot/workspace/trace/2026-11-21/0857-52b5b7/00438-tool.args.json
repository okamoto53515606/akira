shell {"command": "cd /tmp/site && echo \"########## ACCEPT VERIFICATION ##########\" && echo \"badge-new HTML : $(grep -rho 'badge-new' --include=*.html . | wc -l)\" && echo \"tl-new   HTML : $(grep -rho 'tl-new' --include=*.html . | wc -l)\" && echo \"🆕        HTML : $(grep -rho '🆕' --include=*.html . | wc -l)\" && echo \"facts badge-new: $(grep -c 'badge-new' /workspace/data/facts.json)\" && echo \"facts 🆕       : $(grep -c '🆕' /workspace/data/facts.json)\" && echo \"models.json New: $(grep -o '\"New [a-z]*\"' data/models.json | wc -l)\" && echo && echo \"--- ja/en ラベル件数（片側残りが無いか）---\" && for t in \"badge badge-new\" \"🆕\"; do echo \"  '$t' ja=$(grep -rho \"$t\" --include=*.html $(ls -d */ | grep -v '^en/' | sed 's/^/ /') index.html 2>/dev/null | wc -l) en=$(grep -rho \"$t\" --include=*.html en/ | wc -l)\"; done\necho && echo \"--- 最新の \"New\" ラベル残（一般名詞/固有名/公式引用のみ）---\" && python3 - <<'PYEOF'\nimport pathlib,re\nkeep=[]\nfor p in sorted(pathlib.Path('.').rglob('*.html')):\n    for i,l in enumerate(p.read_text(encoding='utf-8').split('\\n'),1):\n        for m in re.finditer(r'(?<![A-Za-z])New(est)?(?![A-Za-z])',l):\n            keep.append((str(p),i,l[max(0,m.start()-45):m.start()+45].strip()))\nprint(\"残存 'New' 件数:\",len(keep))\nfor k in keep: print(\"  %-38s L%-4d %s\"%(k[0],k[1],k[2]))\nPYEOF"}