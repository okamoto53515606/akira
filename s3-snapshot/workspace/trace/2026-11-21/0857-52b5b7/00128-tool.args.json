shell {"command": "cd /workspace && python3 - <<'PYEOF'\nimport json, pathlib\nws = pathlib.Path('/workspace')\nf = ws/'data/facts.json'\nd = json.loads(f.read_text(encoding='utf-8'))\nm = d['models']['gpt-6-cyber']\n\nQ1 = \"GPT‑6 Cyber is initially available through the API and Codex to a select group of approved Daybreak Red customers. / On ExploitGym, which tests whether models can exploit a specified vulnerability, GPT‑6 Cyber scores 48.5%, up from 32.1% for GPT‑5.6 Cyber. / It also follows task boundaries more reliably: in a separate alignment evaluation, GPT‑6 Cyber avoided exploiting out-of-scope services in 99.93% of tests without its deployment prompt, and 100% with this prompt.\"\nQ2 = \"GPT-6 Cyber is a cyber-specialized variant of GPT-6 Astra designed for authorized security work, including tasks such as vulnerability discovery, exploit development, and web pentesting. / Under our Preparedness Framework, we give GPT-6 Cyber the same capability designations as GPT-6 Astra: Critical in Cybersecurity, High in the Biological and Chemical domain, and below High in AI Self-Improvement.\"\nQ3 = \"Prices per 1M tokens. | CyberTrusted Access: [Daybreak](https://openai.com/daybreak/) | gpt-6-cyber | $20.00 | $100.00 | $2.00 | $25.00 | $50.00 |\"\n\nm['sources'] = [\n    {\"url\": \"https://openai.com/index/introducing-gpt-6-cyber/\", \"fetched_at\": \"2026-11-21\", \"quote\": Q1},\n    {\"url\": \"https://deploymentsafety.openai.com/gpt-6-cyber\", \"fetched_at\": \"2026-11-21\", \"quote\": Q2},\n    {\"url\": \"https://developers.openai.com/api/docs/pricing\", \"fetched_at\": \"2026-11-21\", \"quote\": Q3},\n]\nm['released_source'] = \"official-announcement\"\n# 単価は公開済み。ただし提供は Daybreak Red 承認顧客のみ（公式逐語）なので ga ではなく trusted-access\nm['status'] = \"trusted-access\"\nm['price'] = {\n    \"name\": \"GPT-6 Cyber\",\n    \"input\": 20.0,\n    \"output\": 100.0,\n    \"cache_read\": 2.0,\n    \"note_ja\": \"Daybreak Red（承認制）経由のみ・順次拡大予定。100万トークンあたり 入力$20.00／出力$100.00／キャッシュ入力$2.00。cache書込 30分$25／12時間$50\",\n    \"note_en\": \"Available only through Daybreak Red (approved customers; access expanding progressively). $20.00 input / $100.00 output / $2.00 cached input per 1M tokens. Cache writes $25 (30m) / $50 (12h)\",\n    \"label\": \"OpenAI\",\n    \"provider\": \"openai\",\n}\nm['shown_on'] = [\"timeline\", \"pricing\", \"calculator\"]\n\nt = m['timeline']\nt['title_ja'] = \"GPT-6 Cyber 公開 — サイバー特化で ExploitGym 48.5%、$20.00 / $100.00（承認制 Daybreak Red）\"\nt['title_en'] = \"GPT-6 Cyber released — cyber specialist scores 48.5% on ExploitGym at $20.00 / $100.00 (approved Daybreak Red customers)\"\nt['desc_ja'] = (\"OpenAI のサイバーセキュリティ特化モデルで、GPT-6 Astra を土台に脆弱性の探索・エクスプロイト開発・Webペンテスト向けの追加学習を施した<strong>バリアント</strong>です。\"\n    \"攻撃は許可された範囲に限定するよう訓練され、ExploitGym は<strong>48.5%</strong>（GPT-5.6 Cyber は 32.1%）、範囲外サービスへの攻撃回避はデプロイ用プロンプトなしで<strong>99.93%</strong>（ありで100%）。\"\n    \"単価は<strong>入力 $20.00／出力 $100.00（100万トークン）</strong>、キャッシュ入力 $2.00、cache書込 30分$25／12時間$50。\"\n    \"ただし提供は<strong>承認制</strong>で、公式の逐語は「initially available through the API and Codex to a select group of approved Daybreak Red customers」— Daybreak Red の審査通過顧客のみで、順次拡大予定です。\"\n    \"<br><small>※GPT-6 Sol／Terra とは別系統。Preparedness Framework の格付けは GPT-6 Astra と同じ Cybersecurity: Critical。</small>\"\n    \"<span class=\\\"tl-price-badge\\\">$20.00 / $100.00 ・限定提供</span>\")\nt['desc_en'] = (\"OpenAI's cyber-specialized model — a <strong>variant of GPT-6 Astra</strong> with extra training for vulnerability discovery, exploit development and web pentesting, built to stay inside the scope researchers authorize. \"\n    \"It scores <strong>48.5%</strong> on ExploitGym (GPT-5.6 Cyber: 32.1%) and avoided out-of-scope services in <strong>99.93%</strong> of tests without its deployment prompt (100% with it). \"\n    \"Pricing is <strong>$20.00 input / $100.00 output per 1M tokens</strong>, $2.00 cached input, with cache writes at $25.00 (30m) / $50.00 (12h). \"\n    \"Access is <strong>gated</strong>: verbatim, &ldquo;initially available through the API and Codex to a select group of approved Daybreak Red customers&rdquo;, and OpenAI plans to expand progressively. \"\n    \"<br><small>Note: a separate line from GPT-6 Sol / Terra; its Preparedness Framework designations match GPT-6 Astra (Critical in Cybersecurity).</small>\"\n    \"<span class=\\\"tl-price-badge\\\">$20.00 / $100.00 · limited access</span>\")\n\n# --- pricing table: OpenAI 表に 1 行追加（Astra for Law の直後）\noh = [x for x in d['pricing_tables'] if x.get('anchor') == 'oh'][0]\nrow = {\n \"ja\": \"<tr><td class=\\\"model-name\\\">GPT-6 Cyber </td><td class=\\\"price\\\">$20.00</td><td class=\\\"price\\\">$2.00</td><td class=\\\"price\\\">$100.00</td><td>サイバー特化（GPT-6 Astra のバリアント、2026-11-05公開）。<strong>Daybreak Red の承認顧客のみ</strong>・順次拡大予定。cache書込 30分$25／12時間$50。汎用モデルではない点に注意 <a href=\\\"/timeline/#gpt-6-cyber\\\" style=\\\"font-weight:700;\\\">→年表</a></td><td class=\\\"st-cell st-cur\\\">限定提供</td></tr>\",\n \"en\": \"<tr><td class=\\\"model-name\\\">GPT-6 Cyber </td><td class=\\\"price\\\">$20.00</td><td class=\\\"price\\\">$2.00</td><td class=\\\"price\\\">$100.00</td><td>Cyber specialist (a GPT-6 Astra variant, released 2026-11-05). <strong>Approved Daybreak Red customers only</strong>; access expanding progressively. Cache writes $25 (30m) / $50 (12h). Not a general-purpose model <a href=\\\"/en/timeline/#gpt-6-cyber\\\" style=\\\"font-weight:700;\\\">→ timeline</a></td><td class=\\\"st-cell st-cur\\\">Limited</td></tr>\",\n}\nif not any('GPT-6 Cyber' in r['ja'] for r in oh['rows']):\n    idx = next((i for i,r in enumerate(oh['rows']) if 'GPT-6.2 Astra for Law' in r['ja']), 2)\n    oh['rows'].insert(idx+1, row)\n    print('pricing row inserted at', idx+1)\n\nf.write_text(json.dumps(d, ensure_ascii=False, indent=1), encoding='utf-8')\n\n# --- price SOT\nsf = ws/'data/price-sot.json'\ns = json.loads(sf.read_text(encoding='utf-8'))\ns['models']['gpt-6-cyber'] = {\n \"name_ja\": \"GPT-6 Cyber\", \"name_en\": \"GPT-6 Cyber\", \"api_model_id\": \"gpt-6-cyber\",\n \"provider\": \"OpenAI\", \"status\": \"trusted-access\", \"released\": \"2026-11-05\",\n \"price\": {\"cache_hit_input\": 2.0, \"cache_miss_input\": 20.0, \"output\": 100.0,\n           \"cache_write_input_30m\": 25.0, \"cache_write_input_12h\": 50.0},\n \"context\": None, \"max_output\": None,\n \"pages\": [\"/timeline/\", \"/pricing/\", \"/en/timeline/\", \"/en/pricing/\"],\n \"sources\": [\"https://openai.com/index/introducing-gpt-6-cyber/\",\n             \"https://deploymentsafety.openai.com/gpt-6-cyber\",\n             \"https://developers.openai.com/api/docs/pricing\"],\n \"note\": \"サイバー特化（GPT-6 Astra のバリアント）。提供は Daybreak Red の承認顧客のみで順次拡大予定。OpenAI API料金ページの Standard 表（100万トークン）: 入力$20.00／出力$100.00／キャッシュ入力$2.00／cache書込 30分$25・12時間$50。コンテキスト長・APIモデルIDは公式未記載。2026-11-21確認\",\n \"verified\": \"2026-11-21\",\n}\ns['last_verified'] = \"2026-11-21\"\nsf.write_text(json.dumps(s, ensure_ascii=False, indent=1), encoding='utf-8')\nprint('facts+sot written')\nPYEOF\necho \"=== verify facts ===\"\npython3 - <<'PYEOF'\nimport json\nd=json.load(open('/workspace/data/facts.json'))\nm=d['models']['gpt-6-cyber']\nprint('status',m['status'],'released_source',m['released_source'])\nprint('sources:',[(x['url'],x['fetched_at'],bool(x['quote'])) for x in m['sources']])\nprint('price',json.dumps(m['price'],ensure_ascii=False)[:120])\nprint('shown_on',m['shown_on'])\nrows=[x for x in d['pricing_tables'] if x['anchor']=='oh'][0]['rows']\nprint('oh nrows',len(rows))\nimport re\nfor r in rows[:6]:\n    print(' ',re.search(r'model-name\">(.*?)<',r['ja']).group(1), '|', re.search(r'model-name\">(.*?)<',r['en']).group(1))\nPYEOF"}