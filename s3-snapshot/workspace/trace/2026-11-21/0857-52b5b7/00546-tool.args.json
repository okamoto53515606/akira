shell {"command": "cd /workspace && python3 - <<'PYEOF'\nimport json\nf=json.load(open('data/facts.json'))\nprint(\"=== pricing_tables OpenAI 状態列 ===\")\nfor t in f.get('pricing_tables') or []:\n    for r in t.get('rows') or []:\n        name=r.get('name') or r.get('model') or ''\n        if 'GPT-6' in name:\n            print(\"  %-24s status=%-10s ja=%s\"%(name,r.get('status'),str(r.get('ja'))[:70]))\nprint(\"=== price エントリの status（GPT-6系）===\")\nfor k,v in (f.get('price') or {}).items():\n    if 'gpt-6' in k:\n        print(\"  %-26s status=%-14s provider=%s\"%(k,v.get('status'),v.get('provider')))\nprint(\"=== models.json（公開中の計算機データ）GPT-6 ===\")\nfor m in json.load(open('/tmp/site/data/models.json'))['models']:\n    if 'GPT-6' in m['name']:\n        print(\"  %-24s in=%s out=%s note=%s\"%(m['name'],m['input'],m['output'],m.get('note','')[:46]))\nprint(\"=== 公開 /pricing/ の GPT-6 行の状態セル ===\")\nimport re\ns=open('/tmp/site/pricing/index.html',encoding='utf-8').read()\nfor m in re.finditer(r'<tr><td class=\"model-name\">(GPT-[^<]*)</td>(.*?)</tr>',s,re.S):\n    cells=[re.sub('<[^>]+>','',c) for c in re.findall(r'<td[^>]*>(.*?)</td>',m.group(2),re.S)]\n    print(\"  %-22s -> %s\"%(m.group(1),[c for c in cells if c in ('現行','旧版')] or cells[-1:]))\nPYEOF"}