file_read {"toolUseId": "call_00_gVLCrCCL9Z4TGvz9xw2f7751", "status": "success", "content": [{"text": "    }\n   ],\n   \"events\": []\n  },\n  \"gpt-6-cyber\": {\n   \"id\": \"gpt-6-cyber\",\n   \"provider\": \"OpenAI\",\n   \"provider_class\": \"dot-openai\",\n   \"names\": {\n    \"ja\": \"GPT-6 Cyber\",\n    \"en\": \"GPT-6 Cyber\"\n   },\n   \"released\": \"2026-11-05\",\n   \"status\": \"unknown\",\n   \"price\": null,\n   \"timeline\": {\n    \"ja_id\": \"gpt-6-cyber\",\n    \"en_id\": \"gpt-6-cyber\",\n    \"title_ja\": \"GPT-6 Cyber 公開 — サイバーセキュリティ特化、承認制Daybreak Redの顧客向け\",\n    \"title_en\": \"GPT-6 Cyber released — a cybersecurity specialist for approved Daybreak Red customers\",\n    \"desc_ja\": \"脆弱性の発見・検証に特化し、研究者が設定した範囲を守るよう訓練したモデル。ExploitGymは<strong>48.5%</strong>（GPT-5.6 Cyberは32.1%）、範囲外サービスへの攻撃回避はデプロイ用プロンプトなしで99.93%。公式の逐語は「initially available through the API and Codex to a select group of approved Daybreak Red customers」で<strong>限定提供</strong>。<strong>価格はブログに記載がなく未公表</strong>、APIのモデルID・コンテキスト長も公式ページに記載なし。限定提供（承認顧客のみ）かつ価格未公表のため、<strong>料金比較表には掲載していません</strong>。<br><small>※既存のGPT-6系（Sol／Terra）とは別系統のサイバー特化モデルで、通常のAPI料金表の後継関係にはありません。</small><span class=\\\"tl-price-badge\\\">価格未公表（限定提供）</span>\",\n    \"desc_en\": \"A model trained to find and validate exploitable vulnerabilities while staying inside the scope researchers set. It scores <strong>48.5%</strong> on ExploitGym (GPT-5.6 Cyber: 32.1%) and avoided out-of-scope services in 99.93% of tests without its deployment prompt. Verbatim: \\\"initially available through the API and Codex to a select group of approved Daybreak Red customers\\\", so access is <strong>limited</strong>. <strong>No price is given in the launch post</strong>, and the post states neither an API model ID nor a context length. It is not generally available, so we are <strong>covering it in the timeline rather than as a dedicated page</strong>.<br><small>Note: this is a separate cybersecurity line, not a successor to the mainstream GPT-6 Sol / Terra models.</small><span class=\\\"tl-price-badge\\\">Price not published (limited access)</span>\"\n   },\n   \"shown_on\": [\n    \"timeline\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://openai.com/index/introducing-gpt-6-cyber/\",\n     \"fetched_at\": null,\n     \"quote\": null\n    },\n    {\n     \"url\": \"https://deploymentsafety.openai.com/gpt-6-cyber\",\n     \"fetched_at\": null,\n     \"quote\": null\n    }\n   ],\n   \"events\": []\n  },\n  \"gemini-4-carbon\": {\n   \"id\": \"gemini-4-carbon\",\n   \"provider\": \"Google\",\n   \"provider_class\": \"dot-google\",\n   \"names\": {\n    \"ja\": \"Gemini 4 Carbon\",\n    \"en\": \"Gemini 4 Carbon\"\n   },\n   \"released\": \"2026-10-28\",\n   \"status\": \"unknown\",\n"}]}