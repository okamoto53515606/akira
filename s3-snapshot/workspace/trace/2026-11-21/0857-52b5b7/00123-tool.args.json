shell {"command": "mkdir -p /workspace/notes/backup-20261121 && cp /workspace/data/facts.json /workspace/data/price-sot.json /workspace/notes/backup-20261121/ && cd /workspace && python3 - <<'EOF'\nimport re, json, pathlib\ndef paras(p):\n    t=pathlib.Path(p).read_text(encoding='utf-8')\n    out=[]\n    for p_ in re.split(r\"\\n\\s*\\n\", t):\n        out.append(re.sub(r\"\\s+\",\" \",p_).strip())\n    return out\ndef sents(p):\n    res=[]\n    for p_ in paras(p):\n        for s in re.split(r\"(?<=\\.)\\s+\", p_):\n            if s: res.append(s)\n    return res\nblog=sents('cache/gpt-6-cyber-2026-11-21.md')\ncard=sents('cache/gpt-6-cyber-deploymentsafety-2026-11-21.md')\ndef pick(lst,keys):\n    for s in lst:\n        if all(k in s for k in keys): return s\n    return None\nfrags={\n 'blog_avail':pick(blog,[\"initially available through the API and Codex\"]),\n 'blog_gym':pick(blog,[\"scores 48.5%\",\"32.1%\"]),\n 'blog_scope':pick(blog,[\"99.93% of tests\",\"deployment prompt\"]),\n 'card_variant':pick(card,[\"cyber-specialized variant of GPT-6 Astra\"]),\n 'card_prep':pick(card,[\"Critical in Cybersecurity, High in the Biological\"]),\n}\nfor k,v in frags.items():\n    print('###',k,'->',(v[:300] if v else 'NONE'))\n    print()\n# pricing row\nt=pathlib.Path('cache/openai-pricing-check-cyber-2026-11-21.md').read_text(encoding='utf-8')\nm=re.search(r\"^\\|\\s*Cyber.*gpt-6-cyber.*$\", t, re.M)\nprint('### price_row ->', m.group(0) if m else 'NONE')\nprint('### unit ->', [s for s in sents('cache/openai-pricing-check-cyber-2026-11-21.md') if 'per 1M tokens' in s][:2])\nEOF"}