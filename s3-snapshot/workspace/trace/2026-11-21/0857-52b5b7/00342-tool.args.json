shell {"command": "cd /workspace && python3 - <<'PYEOF'\nimport json,re\ninv=json.load(open('notes/newbadge-inventory.json'))\nfor tok in ('値下','プロモ'):\n    print(\"=\"*20,tok)\n    for x in [i for i in inv if i['tok']==tok]:\n        line=x['ctx']\n        kind='PROSE'\n        if 'price-flag' in line: kind='PRICE-FLAG'\n        elif 'badge' in line and 'badge-' in line: kind='BADGE'\n        elif 'tl-price-badge' in line: kind='TL-PRICE'\n        print(\"%-42s L%-5d %-11s %s\" % (x['f'],x['ln'],kind,x['ctx'][:100]))\nPYEOF"}