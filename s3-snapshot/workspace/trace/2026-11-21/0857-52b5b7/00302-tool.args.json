shell {"command": "cd /workspace/data && python3 - <<'EOF'\nimport json\nf=json.load(open('facts.json'))\nprint(\"top keys:\", list(f.keys()))\ndef walk(o,path=\"\"):\n    if isinstance(o,dict):\n        for k,v in o.items():\n            yield from walk(v,path+\"/\"+str(k))\n    elif isinstance(o,list):\n        for i,v in enumerate(o):\n            yield from walk(v,path+\"[%d]\"%i)\n    else:\n        yield path,o\nhits=[(p,v) for p,v in walk(f) if isinstance(v,str) and any(t in v for t in (\"New\",\"🆕\",\"値下\",\"プロモ\",\"badge-new\",\"tl-new\"))]\nprint(\"string hits:\",len(hits))\nfor p,v in hits: print(p,\"=\",v[:160])\nprint(\"--- keys named new ---\")\nprint([p for p,v in walk(f) if p.lower().endswith(\"/new\") or p.lower().endswith(\"_new\") or \"new\" == p.rsplit('/',1)[-1].lower()])\nEOF"}