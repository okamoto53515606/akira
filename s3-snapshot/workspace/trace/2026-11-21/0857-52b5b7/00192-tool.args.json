shell {"command": "for u in https://llm.okamomedia.tokyo/pricing/ https://llm.okamomedia.tokyo/en/pricing/; do echo \"== $u\"; curl -s \"$u\" | grep -c 'model-name\">GPT-6 Cyber'; done; echo \"== models.json\"; curl -s https://llm.okamomedia.tokyo/data/models.json | python3 -c \"\nimport json,sys\nd=json.load(sys.stdin); print('updated',d['updated'])\nprint([m for m in d['models'] if 'Cyber' in m['name']])\"; echo \"== timeline anchors\"; for u in https://llm.okamomedia.tokyo/timeline/ https://llm.okamomedia.tokyo/en/timeline/; do echo -n \"$u \"; curl -s \"$u\" | grep -c 'id=\"gpt-6-cyber\"'; done"}