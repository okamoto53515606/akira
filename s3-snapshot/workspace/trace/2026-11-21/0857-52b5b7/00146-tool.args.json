shell {"command": "cd /tmp/site && python3 - <<'EOF'\nimport re,pathlib,json\nfor rel in ('pricing/index.html','en/pricing/index.html'):\n    s=pathlib.Path(rel).read_text(encoding='utf-8')\n    # find section containing id=\"oh\"\n    m=re.search(r'<section[^>]*id=\"oh\".*?</section>', s, re.S)\n    print(rel,'section oh found:',bool(m))\n    if m:\n        seg=m.group(0)\n        names=re.findall(r'model-name\">(.*?)<', seg)\n        print('  rows',len(names),names[:6])\n        print('  cyber in oh:', any('Cyber' in n for n in names))\n    else:\n        # try fallback: any element with id=\"oh\"\n        i=s.find('id=\"oh\"')\n        print('  raw id oh at',i)\n        print('  cyber rows total', len(re.findall(r'model-name\">GPT-6 Cyber', s)))\nEOF\necho \"=== calc includes cyber? ===\"; grep -c \"Cyber\" /tmp/site/calculator/index.html /tmp/site/en/calculator/index.html 2>/dev/null; python3 -c \"\nimport json;d=json.load(open('/tmp/site/data/models.json'));print('n models',len(d['models']),'first3',[m['name'] for m in d['models'][:3]])\""}