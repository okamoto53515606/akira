shell {"command": "cd /workspace && python3 - <<'PYEOF'\nimport json, pathlib\n# 1) facts.json\nf = pathlib.Path('data/facts.json'); d = json.loads(f.read_text(encoding='utf-8'))\nm = d['models']['gpt-6-cyber']\nt = m['timeline']\nt['desc_ja'] = (\"OpenAI のサイバーセキュリティ特化モデル。System Card の逐語は「cyber-specialized variant of GPT-6 Astra designed for authorized security work, including tasks such as vulnerability discovery, exploit development, and web pentesting」。\"\n  \"許可された範囲内に留まるよう特化した訓練を施しており、ExploitGym は<strong>48.5%</strong>（GPT-5.6 Cyber は 32.1%）、範囲外サービスへの攻撃回避はデプロイ用プロンプトなしで<strong>99.93%</strong>（ありで100%）。\"\n  \"単価は<strong>入力 $20.00／出力 $100.00（100万トークン）</strong>、キャッシュ入力 $2.00、cache書込 30分$25／12時間$50。\"\n  \"ただし提供は<strong>承認制</strong>で、公式の逐語は「initially available through the API and Codex to a select group of approved Daybreak Red customers」「We will progressively expand access to all Daybreak Red customers soon」— Daybreak Red の審査通過顧客のみで、全 Daybreak Red 顧客への拡大を予告しています。\"\n  \"<br><small>※GPT-6 Sol／Terra とは別系統。Preparedness Framework の格付けは GPT-6 Astra と同じ Cybersecurity: Critical。</small>\"\n  \"<span class=\\\"tl-price-badge\\\">$20.00 / $100.00 ・限定提供</span>\")\nt['desc_en'] = (\"OpenAI's cyber-specialized model. The System Card says, verbatim: &ldquo;cyber-specialized variant of GPT-6 Astra designed for authorized security work, including tasks such as vulnerability discovery, exploit development, and web pentesting&rdquo;. \"\n  \"It uses specialized training to stay within authorized scope, scores <strong>48.5%</strong> on ExploitGym (GPT-5.6 Cyber: 32.1%), and avoided out-of-scope services in <strong>99.93%</strong> of tests without its deployment prompt (100% with it). \"\n  \"Pricing is <strong>$20.00 input / $100.00 output per 1M tokens</strong>, $2.00 cached input, with cache writes at $25.00 (30m) / $50.00 (12h). \"\n  \"Access is <strong>gated</strong>: verbatim, &ldquo;initially available through the API and Codex to a select group of approved Daybreak Red customers&rdquo; and &ldquo;We will progressively expand access to all Daybreak Red customers soon&rdquo;. \"\n  \"<br><small>Note: a separate line from GPT-6 Sol / Terra; its Preparedness Framework designations match GPT-6 Astra (Critical in Cybersecurity).</small>\"\n  \"<span class=\\\"tl-price-badge\\\">$20.00 / $100.00 · limited access</span>\")\n# 料金表の備考も「追加学習」断定を外す\noh = [x for x in d['pricing_tables'] if x.get('anchor') == 'oh'][0]\nfor r in oh['rows']:\n    if 'GPT-6 Cyber' in r['ja']:\n        r['ja'] = r['ja'].replace('サイバー特化（GPT-6 Astra のバリアント、2026-11-05公開）', 'サイバー特化（GPT-6 Astra のバリアント、2026-11-05公開）')\n# schema_note に trusted-access を追記（軽微指摘の解消）\nsn = d.get('schema_note', '')\nif 'trusted-access' not in sn:\n    d['schema_note'] = sn.replace('status: announced|preview|ga|retired|unknown', 'status: announced|preview|ga|trusted-access|retired|unknown')\nf.write_text(json.dumps(d, ensure_ascii=False, indent=1), encoding='utf-8')\n\n# 2) price-sot.json の note 修正（クリティカル指摘）\nsf = pathlib.Path('data/price-sot.json'); s = json.loads(sf.read_text(encoding='utf-8'))\ne = s['models']['gpt-6-cyber']\ne['note'] = (\"サイバー特化（GPT-6 Astra のバリアント）。提供は Daybreak Red の承認顧客のみだが、OpenAI は「We will progressively expand access to all Daybreak Red customers soon」としている。\"\n  \"OpenAI API料金ページの Standard 表（Prices per 1M tokens）: 入力$20.00／出力$100.00／キャッシュ入力$2.00／cache書込 30分$25・12時間$50。APIモデルIDは同表の記載どおり gpt-6-cyber。\"\n  \"コンテキスト長・最大出力は公式料金ページに記載なし。2026-11-21確認\")\ne['api_model_id'] = \"gpt-6-cyber\"\nsf.write_text(json.dumps(s, ensure_ascii=False, indent=1), encoding='utf-8')\nprint('fixed')\nprint('schema_note:', d['schema_note'])\nprint('sot note ok:', 'APIモデルIDは同表' in json.loads(sf.read_text(encoding='utf-8'))['models']['gpt-6-cyber']['note'])\nPYEOF\ngrep -c \"追加学習\" /workspace/data/facts.json"}