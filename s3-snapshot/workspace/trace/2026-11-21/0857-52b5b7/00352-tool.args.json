shell {"command": "cd /workspace/data && python3 - <<'PYEOF'\nimport json,re\nf=json.load(open('facts.json'))\nprint(\"### names with trailing New/Updated\")\nfor mid,r in f['models'].items():\n    for lang in ('ja','en'):\n        n=(r.get('names') or {}).get(lang) or ''\n        if re.search(r'\\b(New|Updated)\\s*$',n): print(\"  %-28s %s = %r\"%(mid,lang,n))\nprint(\"### features keys:\", list((f.get('features') or {}).keys()))\nprint(\"### badge-new in facts:\", sum(s.count('badge-new') for s in json.dumps(f).split('\\\\n')))\nprint(\"### 'New <a' occurrences:\")\nfor slug,rec in (f.get('features') or {}).items():\n    for i,b in enumerate(rec.get('blocks') or []):\n        for lang in ('ja','en'):\n            body=b.get('body',{}).get(lang,'') or ''\n            if 'New <a' in body:\n                for m in re.finditer(r'.{40}New <a.{60}',body): print(\"  %s blocks[%d].%s: %s\"%(slug,i,lang,m.group(0)))\nprint(\"### notes with New flagship:\")\nfor mid,r in f['models'].items():\n    for lang in ('ja','en'):\n        nt=(r.get('price') or {}).get('note_'+lang) or ''\n        if 'New' in nt: print(\"  %s note_%s = %r\"%(mid,lang,nt))\nprint(\"### pricing_tables rows with 'New '\")\nfor ti,t in enumerate(f.get('pricing_tables') or []):\n    for ri,row in enumerate(t.get('rows') or []):\n        for lang in ('ja','en'):\n            v=row.get(lang) or ''\n            if 'New ' in v: print(\"  t%d r%d %s: %s\"%(ti,ri,lang,v[:110]))\nPYEOF"}