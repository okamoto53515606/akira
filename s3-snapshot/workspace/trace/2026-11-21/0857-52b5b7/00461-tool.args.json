shell {"command": "cd /workspace && python3 - <<'PYEOF'\nimport json,pathlib\nfp=pathlib.Path('data/facts.json'); f=json.loads(fp.read_text(encoding='utf-8'))\nbody=f['features']['multimodal']['blocks'][2]['body']['ja']\npairs=[\n ('🍌 <strong>Nano Banana 2.1 を追記（2026-10-09）:</strong>',\n  '🍌 <strong>Nano Banana 2.1 の料金:</strong>'),\n ('🔊 <strong>Gemini 3.8 Live / 3.8 Live Extended Thinking を追記（2026-09-23）:</strong>',\n  '🔊 <strong>Gemini 3.8 Live / 3.8 Live Extended Thinking:</strong>'),\n ('🎙️ <strong>Gemini の TTS を3モデルに拡充（2026-10-13 追記）:</strong>',\n  '🎙️ <strong>Gemini の TTS は3モデル:</strong>'),\n]\nfor old,new in pairs:\n    c=body.count(old); print('%d  %s'%(c,old[:56]))\n    body=body.replace(old,new)\nf['features']['multimodal']['blocks'][2]['body']['ja']=body\nfp.write_text(json.dumps(f,ensure_ascii=False,indent=1),encoding='utf-8')\nprint('残 追記 in body:',body.count('追記'))\nPYEOF"}