file_read {"toolUseId": "call_dXJl7om42TdhGuoiI04Uce59", "status": "success", "content": [{"text": "Content of /workspace/data/facts.json:\n{\n \"schema_note\": \"事実台帳。1フィールド1値（追記しない）。文章は当分HTML側に残す。status: announced|preview|ga|retired|unknown。sources は url+fetched_at+quote。\",\n \"updated\": \"2026-11-21\",\n \"models\": {\n  \"gemini-4-hydrogen\": {\n   \"id\": \"gemini-4-hydrogen\",\n   \"provider\": \"Google\",\n   \"provider_class\": \"dot-google\",\n   \"names\": {\n    \"ja\": \"Gemini 4 Hydrogen\",\n    \"en\": \"Gemini 4 Hydrogen\"\n   },\n   \"released\": \"2026-11-12\",\n   \"status\": \"preview\",\n   \"price\": {\n    \"name\": \"Gemini 4 Hydrogen\",\n    \"input\": 1.5,\n    \"output\": 7.5,\n    \"note_ja\": \"100万トークン全体にフラット単価（段階課金なし）。キャッシュ$0.075（暗黙のみ）・無料枠あり\",\n    \"note_en\": \"Flat rate across the full 1M tokens (no tiers). Cache $0.075 (implicit only). Free tier available\",\n    \"label\": \"Google\",\n    \"provider\": \"google\"\n   },\n   \"timeline\": {\n    \"ja_id\": \"gemini-4-hydrogen\",\n    \"en_id\": \"gemini-4-hydrogen\",\n    \"title_ja\": \"Gemini 4 Hydrogen 発表 — 100万トークン全体をフラット単価 $1.50 / $7.50\",\n    \"title_en\": \"Gemini 4 Hydrogen announced — flat $1.50 / $7.50 across the full 1M tokens\",\n    \"desc_ja\": \"Google が「agentic workflows の daily driver」と位置づける新モデル。公式ブログの逐語で「$1.50 per million input tokens and $7.50 per million output tokens」、<strong>100万トークンのコンテキスト全体にフラット単価</strong>（段階課金なし）と明記されています。コンテキストは100万トークン、出力も最大100万トークン。提供先は Google AI Studio・Gemini API・Gemini for business・Gemini アプリ・Google Search・Antigravity・Android Studio・Google Sheets で、「rolling out globally」。<strong>当サイトは提供段階を「段階提供（GA表記なし）」と判断</strong>しました。料金ページにはモデル行があり、入力$1.50／出力$7.50／コンテキストキャッシュ$0.075（暗黙キャッシュのみ・明示キャッシュ非対応）。Batch の記載は料金ページに見当たりません。<span class=\\\"tl-price-badge\\\">$1.50 / $7.50</span>\",\n    \"desc_en\": \"Google positions it as the &ldquo;daily driver for agentic workflows&rdquo;. The official blog states &ldquo;$1.50 per million input tokens and $7.50 per million output tokens&rdquo; with a <strong>flat rate across the entire one-million-token context</strong> (no tiered pricing). Context is 1M tokens and output can reach 1M tokens. It is available in Google AI Studio, the Gemini API, Gemini for business, the Gemini app, Google Search, Antigravity, Android Studio and Google Sheets, &ldquo;rolling out globally&rdquo;. <strong>We read the release stage as a staged rollout with no GA label.</strong> The pricing page lists the model at $1.50 input / $7.50 output / $0.075 context caching (implicit caching only; explicit caching is not supported). No batch pricing is listed.<span class=\\\"tl-price-badge\\\">$1.50 / $7.50</span>\"\n   },\n   \"shown_on\": [\n    \"calculator\",\n    \"pricing\",\n    \"timeline\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://blog.google/innovation-and-ai/models-and-research/gemini-models/introducing-gemini-4-hydrogen/\",\n     \"fetched_at\": \"2026-11-14\",\n     \"quote\": \"$1.50 per million input tokens and $7.50 per million output tokens\"\n    },\n    {\n     \"url\": \"https://ai.google.dev/gemini-api/docs/pricing\",\n     \"fetched_at\": \"2026-11-21\",\n     \"quote\": null\n    }\n   ],\n   \"events\": []\n  },\n  \"qwen4-max-preview\": {\n   \"id\": \"qwen4-max-preview\",\n   \"provider\": \"Alibaba / Qwen\",\n   \"provider_class\": \"dot-other\",\n   \"names\": {\n    \"ja\": \"Qwen4-Max\",\n    \"en\": \"Qwen4-Max\"\n   },\n   \"released\": \"2026-11-15\",\n   \"status\": \"ga\",\n   \"price\": {\n    \"name\": \"Qwen4-Max\",\n    \"input\": 1.5,\n    \"output\": 4.5,\n    \"provider\": \"alibaba\",\n    \"label\": \"Alibaba\",\n    \"note_ja\": \"1Mコンテキスト・最大入力991K・出力131K（thinking時262K）。暗黙キャッシュ$0.075、明示キャッシュ作成は5分$1.875／1時間$3.00\",\n    \"note_en\": \"1M context, up to 991K input, 131K output (262K when thinking). Implicit cache $0.075; explicit cache writes $1.875 (5 min) / $3.00 (1 hour)\"\n   },\n   \"timeline\": {\n    \"ja_id\": \"qwen4-max-preview\",\n    \"en_id\": \"qwen4-max-preview\",\n    \"title_ja\": \"Qwen4-Max 正式提供 — 入力$1.50／出力$4.50・1Mコンテキスト\",\n    \"title_en\": \"Qwen4-Max goes live at $1.50 / $4.50 per 1M tokens with 1M context\",\n    \"desc_ja\": \"Alibaba の次世代フラッグシップ <strong>Qwen4-Max</strong> が QwenCloud（Alibaba Cloud Model Studio）で提供中。公式料金は<strong>入力$1.50／出力$4.50／暗黙キャッシュ$0.075</strong>（1Mトークン）、明示キャッシュの作成は5分TTL $1.875・1時間TTL $3.00です。1Mトークンコンテキスト（最大入力991K・通常出力131K／thinking時262K）でtext/image/video入力に対応。11-11からToken Plan限定で先行提供されていた <code>qwen4-max-preview</code> が、単価公表とともに正式提供へ移行しました。ベンチマークと重みの公開状況は未確認です。<span class=\\\"tl-price-badge\\\">$1.50 / $4.50</span>\",\n    \"desc_en\": \"Alibaba&#39;s next-generation flagship <strong>Qwen4-Max</strong> is available on QwenCloud (Alibaba Cloud Model Studio). Official pricing is <strong>$1.50 input / $4.50 output / $0.075 implicit cache</strong> per 1M tokens, with explicit cache writes at $1.875 (5 min TTL) and $3.00 (1 hour TTL). It has a 1M-token context (up to 991K input; 131K output, 262K when thinking) and takes text, image and video input. The Token Plan-only preview (<code>qwen4-max-preview</code>, from 11-11) moved to general availability with published unit prices. Benchmarks and weight availability are unconfirmed.<span class=\\\"tl-price-badge\\\">$1.50 / $4.50</span>\"\n   },\n   \"shown_on\": [\n    \"calculator\",\n    \"pricing\",\n    \"timeline\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://www.qwencloud.com/benefits/tokenplan\",\n     \"fetched_at\": \"2026-11-14\",\n     \"quote\": null\n    }\n   ],\n   \"events\": []\n  },\n  \"gemini-4-carbon-ga\": {\n   \"id\": \"gemini-4-carbon-ga\",\n   \"provider\": \"Google\",\n   \"provider_class\": \"dot-google\",\n   \"names\": {\n    \"ja\": \"Gemini 4 Carbon\",\n    \"en\": \"Gemini 4 Carbon\"\n   },\n   \"released\": \"2026-11-10\",\n   \"status\": \"ga\",\n   \"price\": {\n    \"name\": \"Gemini 4 Carbon\",\n    \"input\": 2.0,\n    \"output\": 10.0,\n    \"note_ja\": \"導入価格(〜2026-11-30)・通常$4/$20。キャッシュ$0.10→$0.20（暗黙のみ）。Batch非対応・無料枠なし\",\n    \"note_en\": \"Intro pricing (through 2026-11-30) · list $4/$20. Cache $0.10→$0.20 (implicit only). No Batch API, no free tier\",\n    \"label\": \"Google\",\n    \"provider\": \"google\"\n   },\n   \"timeline\": {\n    \"ja_id\": \"gemini-4-carbon-ga\",\n    \"en_id\": \"gemini-4-carbon-ga\",\n    \"title_ja\": \"Gemini 4 Carbon が一般提供へ — 公式料金ページにモデル行が登場\",\n    \"title_en\": \"Gemini 4 Carbon goes generally available — model row added to the official pricing page\",\n    \"desc_ja\": \"2026-11-03時点では限定提供（cyber defenders・Fairwind）で、公式料金ページにモデル行がありませんでした。今回の公式ブログは「Today, we're making Gemini 4 Carbon available to developers, enterprises, scientists, and consumers.」と発表し、Google AI Studio・Gemini for business のAPIで<strong>支払いのある開発者・企業すべて</strong>が利用可能になりました。料金は導入価格で<strong>入力$2.00 / 出力$10.00</strong>（2026-11-30まで）、<strong>12月1日から入力$4.00 / 出力$20.00</strong>。ただしCarbonは<strong>Batch API非対応</strong>（公式料金ページに「Batch API isn't supported」）。<span class=\\\"tl-price-badge\\\">$2.00 / $10.00（11/30まで）</span>\",\n    \"desc_en\": \"As of 2026-11-03 Carbon was invitation-only (cyber defenders and the Fairwind programme) and had no model row on the official pricing page. The official blog now says &ldquo;Today, we&#39;re making Gemini 4 Carbon available to developers, enterprises, scientists, and consumers.&rdquo;, so any paying developer or business can use it through Google AI Studio and the Gemini for business API. Introductory pricing is <strong>$2.00 input / $10.00 output</strong> through 2026-11-30, then <strong>$4.00 / $20.00 from December 1</strong>. Carbon does <strong>not</strong> support the Batch API (&ldquo;Batch API isn&#39;t supported&rdquo; on the official pricing page).<span class=\\\"tl-price-badge\\\">$2.00 / $10.00 (to 11/30)</span>\"\n   },\n   \"shown_on\": [\n    \"calculator\",\n    \"pricing\",\n    \"timeline\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://blog.google/innovation-and-ai/models-and-research/gemini-models/gemini-4-carbon-now-available/\",\n     \"fetched_at\": \"2026-11-14\",\n     \"quote\": \"Today, we're making Gemini 4 Carbon available to developers, enterprises, scientists, and consumers.\"\n    },\n    {\n     \"url\": \"https://ai.google.dev/gemini-api/docs/pricing\",\n     \"fetched_at\": \"2026-11-21\",\n     \"quote\": null\n    }\n   ],\n   \"events\": []\n  },\n  \"muse-ember\": {\n   \"id\": \"muse-ember\",\n   \"provider\": \"Meta\",\n   \"provider_class\": \"dot-meta\",\n   \"names\": {\n    \"ja\": \"Muse Ember\",\n    \"en\": \"Muse Ember\"\n   },\n   \"released\": \"2026-11-09\",\n   \"status\": \"ga\",\n   \"price\": {\n    \"name\": \"Muse Ember\",\n    \"input\": 0.1,\n    \"output\": 0.5,\n    \"note_ja\": \"Meta Model API の最小・最効率モデル。$0.10/$0.50（1Mトークン）\",\n    \"note_en\": \"Meta's smallest and most efficient model on the Model API. $0.10/$0.50 per 1M tokens\",\n    \"provider\": \"Meta\"\n   },\n   \"timeline\": {\n    \"ja_id\": \"muse-ember\",\n    \"en_id\": \"muse-ember\",\n    \"title_ja\": \"Muse Ember 公開 — Metaで最小・最効率のモデル、$0.10 / $0.50\",\n    \"title_en\": \"Muse Ember released — Meta's smallest and most efficient model at $0.10 / $0.50\",\n    \"desc_ja\": \"Muse Wonder（最も難しい問題向け）・Muse Spark（コーディング／エージェント）に続く小型モデルで、ツール呼び出し・コーディングのサブタスク・ルーティング・抽出・長文書パースなど「エージェントが一日中くり返す作業」向けと位置づけられています。公式ブログの逐語は「available today on the Meta Model API, at $0.10 per million input tokens and $0.50 per million output tokens」。<code>muse-ember-1.0</code> として Muse Code と Meta Model API で提供され、Google Cloud・Oracle Cloud からも利用できます。<span class=\\\"tl-price-badge\\\">$0.10 / $0.50</span>\",\n    \"desc_en\": \"A small model that follows Muse Wonder (hardest problems) and Muse Spark (coding and agents), positioned for &ldquo;the work an agent repeats all day&rdquo;: tool calls, coding subtasks, routing, extraction and long-document parsing. The official blog says &ldquo;available today on the Meta Model API, at $0.10 per million input tokens and $0.50 per million output tokens&rdquo;. It ships as <code>muse-ember-1.0</code> in Muse Code and the Meta Model API, and is also available through Google Cloud and Oracle Cloud.<span class=\\\"tl-price-badge\\\">$0.10 / $0.50</span>\"\n   },\n   \"shown_on\": [\n    \"timeline\",\n    \"pricing\",\n    \"calculator\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://research.meta.ai/blog/muse-ember\",\n     \"fetched_at\": \"2026-11-14\",\n     \"quote\": \"available today on the Meta Model API, at $0.10 per million input tokens and $0.50 per million output tokens\"\n    }\n   ],\n   \"events\": []\n  },\n  \"claude-fable-5-2\": {\n   \"id\": \"claude-fable-5-2\",\n   \"provider\": \"Anthropic\",\n   \"provider_class\": \"dot-anthropic\",\n   \"names\": {\n    \"ja\": \"Claude Fable 5.2 / Mythos 5.2\",\n    \"en\": \"Claude Fable 5.2 / Mythos 5.2\"\n   },\n   \"released\": \"2026-11-09\",\n   \"status\": \"ga\",\n   \"price\": {\n    \"name\": \"Claude Fable 5.2\",\n    \"input\": 8.0,\n    \"output\": 40.0,\n    \"note_ja\": \"前世代（Fable 5.1）から入出力とも20%安（$10/$50→$8/$40）。キャッシュ読込$0.20。fast modeは$16/$80。Batch入力$4/MTok\",\n    \"note_en\": \"20% cheaper than Fable 5.1 on both input and output ($10/$50 to $8/$40). Cache read $0.20; fast mode $16/$80; Batch input $4/MTok\",\n    \"provider\": \"Anthropic\"\n   },\n   \"timeline\": {\n    \"ja_id\": \"claude-fable-5-2\",\n    \"en_id\": \"claude-fable-5-2\",\n    \"title_ja\": \"Claude Fable 5.2 / Mythos 5.2 公開 — 前世代から20%安い $8 / $40\",\n    \"title_en\": \"Claude Fable 5.2 / Mythos 5.2 released — 20% cheaper than the previous generation at $8 / $40\",\n    \"desc_ja\": \"コーディング・推論・視覚がFable 5.1 / Mythos 5.1から改善し、出力生成は最大30%高速化。料金は公式ブログの逐語で「available at a lower price: $8 per million input tokens and $40 per million output tokens」、前世代の$10 / $50から入出力とも20%安くなりました。fast modeは$16 / $80。<strong>Fable 5.2は全ユーザー向け</strong>（「available today on all platforms, including Amazon Web Services, Google Cloud, and Microsoft Azure」）、Mythos 5.2はサイバー／ライフサイエンスの検証プログラム経由の提供です。Batchは入力$4 / MTok（通常の50%）。<span class=\\\"tl-price-badge\\\">$8 / $40</span>\",\n    \"desc_en\": \"Coding, reasoning and vision improved over Fable 5.1 / Mythos 5.1, with output generation up to 30% faster. The official blog states &ldquo;available at a lower price: $8 per million input tokens and $40 per million output tokens&rdquo; &mdash; 20% below the previous $10 / $50 on both input and output. Fast mode is $16 / $80. <strong>Fable 5.2 is available to all users</strong> (&ldquo;available today on all platforms, including Amazon Web Services, Google Cloud, and Microsoft Azure&rdquo;); Mythos 5.2 is offered through the cyber and life-sciences validation programme. Batch input is $4 / MTok (50% of standard).<span class=\\\"tl-price-badge\\\">$8 / $40</span>\"\n   },\n   \"shown_on\": [\n    \"timeline\",\n    \"pricing\",\n    \"calculator\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://www.anthropic.com/claude-fable-and-mythos-5-2\",\n     \"fetched_at\": \"2026-11-14\",\n     \"quote\": \"available at a lower price: $8 per million input tokens and $40 per million output tokens\"\n    },\n    {\n     \"url\": \"https://platform.claude.com/docs/en/models/fable-5-2/overview\",\n     \"fetched_at\": null,\n     \"quote\": null\n    }\n   ],\n   \"events\": []\n  },\n  \"gpt-6-cyber\": {\n   \"id\": \"gpt-6-cyber\",\n   \"provider\": \"OpenAI\",\n   \"provider_class\": \"dot-openai\",\n   \"names\": {\n    \"ja\": \"GPT-6 Cyber\",\n    \"en\": \"GPT-6 Cyber\"\n   },\n   \"released\": \"2026-11-05\",\n   \"status\": \"trusted-access\",\n   \"price\": {\n    \"name\": \"GPT-6 Cyber\",\n    \"input\": 20.0,\n    \"output\": 100.0,\n    \"cache_read\": 2.0,\n    \"note_ja\": \"Daybreak Red（承認制）経由のみ・順次拡大予定。100万トークンあたり 入力$20.00／出力$100.00／キャッシュ入力$2.00。cache書込 30分$25／12時間$50\",\n    \"note_en\": \"Available only through Daybreak Red (approved customers; access expanding progressively). $20.00 input / $100.00 output / $2.00 cached input per 1M tokens. Cache writes $25 (30m) / $50 (12h)\",\n    \"label\": \"OpenAI\",\n    \"provider\": \"openai\"\n   },\n   \"timeline\": {\n    \"ja_id\": \"gpt-6-cyber\",\n    \"en_id\": \"gpt-6-cyber\",\n    \"title_ja\": \"GPT-6 Cyber 公開 — サイバー特化で ExploitGym 48.5%、$20.00 / $100.00（承認制 Daybreak Red）\",\n    \"title_en\": \"GPT-6 Cyber released — cyber specialist scores 48.5% on ExploitGym at $20.00 / $100.00 (approved Daybreak Red customers)\",\n    \"desc_ja\": \"OpenAI のサイバーセキュリティ特化モデルで、GPT-6 Astra を土台に脆弱性の探索・エクスプロイト開発・Webペンテスト向けの追加学習を施した<strong>バリアント</strong>です。攻撃は許可された範囲に限定するよう訓練され、ExploitGym は<strong>48.5%</strong>（GPT-5.6 Cyber は 32.1%）、範囲外サービスへの攻撃回避はデプロイ用プロンプトなしで<strong>99.93%</strong>（ありで100%）。単価は<strong>入力 $20.00／出力 $100.00（100万トークン）</strong>、キャッシュ入力 $2.00、cache書込 30分$25／12時間$50。ただし提供は<strong>承認制</strong>で、公式の逐語は「initially available through the API and Codex to a select group of approved Daybreak Red customers」— Daybreak Red の審査通過顧客のみで、順次拡大予定です。<br><small>※GPT-6 Sol／Terra とは別系統。Preparedness Framework の格付けは GPT-6 Astra と同じ Cybersecurity: Critical。</small><span class=\\\"tl-price-badge\\\">$20.00 / $100.00 ・限定提供</span>\",\n    \"desc_en\": \"OpenAI's cyber-specialized model — a <strong>variant of GPT-6 Astra</strong> with extra training for vulnerability discovery, exploit development and web pentesting, built to stay inside the scope researchers authorize. It scores <strong>48.5%</strong> on ExploitGym (GPT-5.6 Cyber: 32.1%) and avoided out-of-scope services in <strong>99.93%</strong> of tests without its deployment prompt (100% with it). Pricing is <strong>$20.00 input / $100.00 output per 1M tokens</strong>, $2.00 cached input, with cache writes at $25.00 (30m) / $50.00 (12h). Access is <strong>gated</strong>: verbatim, &ldquo;initially available through the API and Codex to a select group of approved Daybreak Red customers&rdquo;, and OpenAI plans to expand progressively. <br><small>Note: a separate line from GPT-6 Sol / Terra; its Preparedness Framework designations match GPT-6 Astra (Critical in Cybersecurity).</small><span class=\\\"tl-price-badge\\\">$20.00 / $100.00 · limited access</span>\"\n   },\n   \"shown_on\": [\n    \"timeline\",\n    \"pricing\",\n    \"calculator\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://openai.com/index/introducing-gpt-6-cyber/\",\n     \"fetched_at\": \"2026-11-21\",\n     \"quote\": \"GPT‑6 Cyber is initially available through the API and Codex to a select group of approved Daybreak Red customers. / On ExploitGym, which tests whether models can exploit a specified vulnerability, GPT‑6 Cyber scores 48.5%, up from 32.1% for GPT‑5.6 Cyber. / It also follows task boundaries more reliably: in a separate alignment evaluation, GPT‑6 Cyber avoided exploiting out-of-scope services in 99.93% of tests without its deployment prompt, and 100% with this prompt.\"\n    },\n    {\n     \"url\": \"https://deploymentsafety.openai.com/gpt-6-cyber\",\n     \"fetched_at\": \"2026-11-21\",\n     \"quote\": \"GPT-6 Cyber is a cyber-specialized variant of GPT-6 Astra designed for authorized security work, including tasks such as vulnerability discovery, exploit development, and web pentesting. / Under our Preparedness Framework, we give GPT-6 Cyber the same capability designations as GPT-6 Astra: Critical in Cybersecurity, High in the Biological and Chemical domain, and below High in AI Self-Improvement.\"\n    },\n    {\n     \"url\": \"https://developers.openai.com/api/docs/pricing\",\n     \"fetched_at\": \"2026-11-21\",\n     \"quote\": \"Prices per 1M tokens. | CyberTrusted Access: [Daybreak](https://openai.com/daybreak/) | gpt-6-cyber | $20.00 | $100.00 | $2.00 | $25.00 | $50.00 |\"\n    }\n   ],\n   \"events\": [],\n   \"released_source\": \"official-announcement\"\n  },\n  \"gemini-4-carbon\": {\n   \"id\": \"gemini-4-carbon\",\n   \"provider\": \"Google\",\n   \"provider_class\": \"dot-google\",\n   \"names\": {\n    \"ja\": \"Gemini 4 Carbon\",\n    \"en\": \"Gemini 4 Carbon\"\n   },\n   \"released\": \"2026-10-28\",\n   \"status\": \"unknown\",\n   \"price\": {\n    \"name\": \"Gemini 4 Carbon\",\n    \"input\": 2.0,\n    \"output\": 10.0,\n    \"note_ja\": \"導入価格(〜2026-11-30)・通常$4/$20。キャッシュ$0.10→$0.20（暗黙のみ）。Batch非対応・無料枠なし\",\n    \"note_en\": \"Intro pricing (through 2026-11-30) · list $4/$20. Cache $0.10→$0.20 (implicit only). No Batch API, no free tier\",\n    \"label\": \"Google\",\n    \"provider\": \"google\"\n   },\n   \"timeline\": {\n    \"ja_id\": \"gemini-4-carbon\",\n    \"en_id\": \"gemini-4-carbon\",\n    \"title_ja\": \"Gemini 4 Carbon 発表 — サイバー防御重視、当面は限定提供\",\n    \"title_en\": \"Gemini 4 Carbon announced — cyber-defense focus, limited access for now\",\n    \"desc_ja\": \"<strong>提供段階</strong>: <strong>GAではなく限定提供（発表のみ）</strong>。公式逐語は「Starting this week, we will make Carbon available to a subset of cyber defenders and will gradually phase access to additional trusted partners through our Fairwind Program」。開発者・企業・消費者向けは「as soon as possible」＝<strong>未提供</strong>で、米政府の事前検証プロセスに参加中と明記。<br><strong>料金: 未掲載</strong>。Google公式料金ページ（ai.google.dev/gemini-api/docs/pricing）に Gemini 4 Carbon の行はなく、2026-11-03時点で確認できた Gemini 4 系の行は Gemini 4 Argon のみ。ブログには<strong>予告</strong>として「will launch at the same introductory price as Argon at $2 per million input tokens and $10 per million output tokens, with cached input tokens priced at 95% off input token price」、脚注で導入期間終了後は入力$4.00／出力$20.00と記載。ただし<strong>料金ページに未掲載のため確定価格としては扱わない</strong>。<br><strong>ベンチ</strong>: Artificial Analysis Intelligence Index v5.0 で59・1位（Artificial Analysisの指標）。SEC-bench Pro 88.2%（sec-bench）・ExploitGym 54.8%（sunblaze-ucb/exploitgym）・CWE-bench 71.0%（Collinear）はいずれも外部ベンチで、公式は「evaluated without guardrails」（ガードレール無しの評価）と明記。WebDev Arenaは1768で4位（+89 elo）。「Argon比で安全なコード生成の成功率2倍超」「Chromeチームが他社フラッグシップ比10倍超のパッチ品質」はGoogle社内・提携先の主張。<br><strong>未公表</strong>: APIモデル名・コンテキスト長・出力上限・知識カットオフ・段階課金は当該ブログに記載が無いため、確認できるまで当サイトでは書かない。<span class=\\\"tl-price-badge\\\">料金未掲載（予告 $2.00/$10.00）</span>\",\n    \"desc_en\": \"<strong>Availability</strong>: <strong>limited access, not GA</strong>. Verbatim: \\\"Starting this week, we will make Carbon available to a subset of cyber defenders and will gradually phase access to additional trusted partners through our Fairwind Program.\\\" Access for developers, businesses and consumers is \\\"as soon as possible\\\" i.e. <strong>not available yet</strong>; Google says it is taking part in the U.S. government's voluntary pre-release testing process.<br><strong>Price: not listed</strong>. Google's official pricing page (ai.google.dev/gemini-api/docs/pricing) has no Gemini 4 Carbon row; as of Nov 3, 2026 the only Gemini 4 row there is Gemini 4 Argon. The blog <strong>announces</strong> a launch price: \\\"will launch at the same introductory price as Argon at $2 per million input tokens and $10 per million output tokens, with cached input tokens priced at 95% off input token price\\\", with a footnote adding $4.00 input / $20.00 output after the introductory period. We do not treat these as shipping prices.<br><strong>Benchmarks</strong>: #1 at 59 on Artificial Analysis Intelligence Index v5.0 (Artificial Analysis's own index). SEC-bench Pro 88.2% (sec-bench), ExploitGym 54.8% (sunblaze-ucb/exploitgym) and CWE-bench 71.0% (Collinear) are third-party benchmarks, and Google notes they were \\\"evaluated without guardrails\\\". WebDev Arena: #4 at 1768 (+89 elo). Claims such as \\\"more than 2x uplift\\\" in secure code generation versus Argon and the Chrome team's \\\"more than 10X better\\\" patch quality are Google-internal or partner claims.<br><strong>Not disclosed</strong>: API model name, context window, output limit, knowledge cutoff and tiered pricing are absent from the post, so we do not state them.<span class=\\\"tl-price-badge\\\">Price not listed (announced $2.00/$10.00)</span>\"\n   },\n   \"shown_on\": [\n    \"calculator\",\n    \"pricing\",\n    \"timeline\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://blog.google/innovation-and-ai/models-and-research/gemini-models/introducing-gemini-4-carbon/\",\n     \"fetched_at\": \"2026-11-21\",\n     \"quote\": null\n    }\n   ],\n   \"events\": []\n  },\n  \"gpt-6-1-terra\": {\n   \"id\": \"gpt-6-1-terra\",\n   \"provider\": \"OpenAI\",\n   \"provider_class\": \"dot-openai\",\n   \"names\": {\n    \"ja\": \"GPT-6.1 Terra\",\n    \"en\": \"GPT-6.1 Terra launched\"\n   },\n   \"released\": \"2026-10-26\",\n   \"status\": \"unknown\",\n   \"price\": {\n    \"name\": \"GPT-6.1 Terra\",\n    \"input\": 1.0,\n    \"output\": 5.0,\n    \"note_ja\": \"キャッシュ入力$0.05（入力の5%）・272,000トークン超はリクエスト全体が入力2倍/出力1.5倍。1.05Mコンテキスト・128K出力\",\n    \"note_en\": \"cached input $0.05 (5% of input) · above 272,000 input tokens the whole request is repriced at 2x input / 1.5x output · 1.05M context, 128K output\",\n    \"label\": \"OpenAI\",\n    \"provider\": \"openai\"\n   },\n   \"timeline\": {\n    \"ja_id\": \"gpt-6-1-terra\",\n    \"en_id\": \"gpt-6-1-terra\",\n    \"title_ja\": \"GPT-6.1 Terra 公開 — 「速くて安い」コンピュータ操作モデル\",\n    \"title_en\": \"GPT-6.1 Terra launched — a fast, low-cost computer-use model\",\n    \"desc_ja\": \"GPT-5.6 Terraの上位後継（公式逐語は「A significant step up from GPT-5.6 Terra」）。標準APIは入力$1.00・キャッシュ入力$0.05・出力$5.00（1Mトークン）で、公式ブログは「GPT-5.6 TerraとGPT-6.1 Solの50%下」と明記。1,050,000コンテキスト・128,000出力、272,000トークン超はリクエスト全体が入力2倍/出力1.5倍。ChatGPT Work・Codex（Plus/Pro/Enterprise/Edu）とAPI（<code>gpt-6.1-terra</code>）で提供。<br><small>※公式ブログにリリース日の明記なし（「Starting today」）。第三者報道は2026-10-26で一致。</small><span class=\\\"tl-price-badge\\\">$1.00/$5.00（キャッシュ$0.05）</span>\",\n    \"desc_en\": \"The step up from GPT-5.6 Terra (\\\"A significant step up from GPT-5.6 Terra\\\" in OpenAI's own words). Standard API pricing is $1.00 input / $0.05 cached input / $5.00 output per 1M tokens, which the launch post describes as 50% lower than GPT-5.6 Terra and GPT-6.1 Sol. 1,050,000-token context, 128,000 max output; above 272,000 input tokens the whole request is repriced at 2x input and 1.5x output. Available in ChatGPT Work and Codex (Plus/Pro/Enterprise/Edu) and via API as <code>gpt-6.1-terra</code>.<br><small>Note: the launch post gives no explicit date (\\\"Starting today\\\"); third-party coverage agrees on 2026-10-26.</small> <span class=\\\"tl-price-badge\\\">$1.00/$5.00 (cached $0.05)</span>\"\n   },\n   \"shown_on\": [\n    \"calculator\",\n    \"pricing\",\n    \"timeline\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://openai.com/index/introducing-gpt-6-1-terra/\",\n     \"fetched_at\": null,\n     \"quote\": null\n    }\n   ],\n   \"events\": []\n  },\n  \"kimi-k3-1-pro\": {\n   \"id\": \"kimi-k3-1-pro\",\n   \"provider\": \"Moonshot\",\n   \"provider_class\": \"dot-other\",\n   \"names\": {\n    \"ja\": \"Kimi K3.1 Pro シリーズ\",\n    \"en\": \"Kimi K3.1 Pro series rolls out\"\n   },\n   \"released\": \"2026-10-23\",\n   \"status\": \"unknown\",\n   \"price\": null,\n   \"timeline\": {\n    \"ja_id\": \"kimi-k3-1-pro\",\n    \"en_id\": \"kimi-k3-1-pro\",\n    \"title_ja\": \"Kimi K3.1 Pro シリーズ提供開始 — 3Tクラス・1Mコンテキスト\",\n    \"title_en\": \"Kimi K3.1 Pro series rolls out — 3T-class, 1M context\",\n    \"desc_ja\": \"新しいK3.1シリーズの第1弾。Kimi Code公式の表現は「our most capable 3T-class model to date」で、1Mトークンコンテキストとコーディング・3D制作・財務リサーチ等の長時間エージェント能力を強化。同品質で約2〜3倍速の<strong>K3.1 Pro Highspeed</strong>も同時提供（Kimi Codeの提供条件は K3.1 Pro が Plus/Moderato 以上・Pro/Allegretto 以上で最大1Mコンテキスト、Highspeed は Pro/Allegretto 以上）。thinkingは low/high/max（既定high）のみ。（公式料金ページに <code>kimi-k3.1-pro</code> 行を確認。入力$2.00・出力$10.00・キャッシュ入力$0.20。1,048,576コンテキスト、Batchは標準の60%）<span class=\\\"tl-price-badge\\\">$2.00/$10.00（キャッシュ$0.20）</span>\",\n    \"desc_en\": \"First model in the new K3.1 series. In Kimi's own words, \\\"our most capable 3T-class model to date\\\", with a 1M-token context and stronger coding, 3D creation, financial research and long-horizon agent work. <strong>K3.1 Pro Highspeed</strong> ships alongside it at roughly 2-3x the speed with the same quality (K3.1 Pro on Plus/Moderato and above; Pro/Allegretto and above unlock up to 1M context; Highspeed on Pro/Allegretto and above). Thinking mode only: low/high/max, default high.  (2026-11-07 update: the official pricing page now has a <code>kimi-k3.1-pro</code> row: $2.00 input, $10.00 output, $0.20 cached input, 1,048,576 context, Batch at 60%.)<span class=\\\"tl-price-badge\\\">$2.00/$10.00 (cached $0.20)</span>\"\n   },\n   \"shown_on\": [\n    \"pricing\",\n    \"timeline\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://www.kimi.com/code/docs/en/kimi-code/whats-new.html\",\n     \"fetched_at\": null,\n     \"quote\": null\n    }\n   ],\n   \"events\": []\n  },\n  \"gemini-4-argon\": {\n   \"id\": \"gemini-4-argon\",\n   \"provider\": \"Google\",\n   \"provider_class\": \"dot-google\",\n   \"names\": {\n    \"ja\": \"Gemini 4 Argon 公開（GA）— 1Mコンテキストのフラッグシップ推論モデル New\",\n    \"en\": \"Gemini 4 Argon is generally available\"\n   },\n   \"released\": \"2026-10-13\",\n   \"status\": \"unknown\",\n   \"price\": null,\n   \"timeline\": {\n    \"ja_id\": \"gemini-4-argon\",\n    \"en_id\": \"gemini-4-argon\",\n    \"title_ja\": \"Gemini 4 Argon 公開（GA）— 1Mコンテキストのフラッグシップ推論モデル\",\n    \"title_en\": \"Gemini 4 Argon is generally available — a 1M-context flagship reasoning model\",\n    \"desc_ja\": \"<strong>料金</strong>: 入力$2.00・出力$10.00（思考トークン含む）・コンテキストキャッシュ$0.10（USD/1M）。いずれも<strong>2026年11月30日までの導入価格</strong>で、12月1日から$4.00 / $20.00 / $0.20に改定。<strong>暗黙キャッシュのみ</strong>対応（明示キャッシュは非対応）、無料枠は「Not available」。<br><strong>仕様</strong>: コンテキストウィンドウ1,048,576（入力と出力の統合上限）・最大出力65,536（同期）、long decodeで最大1,048,576。モデルID <code>gemini-4-argon</code>、ステータスはStable（GA＝一般提供）。公式モデルページの記載は「Latest update: October 2026」。<br><strong>位置づけ</strong>: 複雑なソフトウェアエンジニアリング、数学・科学の難問、自律的なマルチステップエージェント、長い出力（long decode）向けのフラッグシップ推論モデル。<span class=\\\"tl-price-badge\\\">$2.00 / $10.00（〜11/30・キャッシュ$0.10）</span>\",\n    \"desc_en\": \"<strong>Pricing</strong>: $2.00 input / $10.00 output (including thinking tokens) / $0.10 context caching per 1M tokens. All are <strong>introductory rates through November 30, 2026</strong>, rising to $4.00 / $20.00 / $0.20 on December 1. <strong>Implicit caching only</strong> (explicit caching is not supported) and no free tier (&ldquo;Not available&rdquo;).<br><strong>Specs</strong>: 1,048,576-token context window (a unified input and output limit), 65,536 max output synchronously and up to 1,048,576 with long decode. Model ID <code>gemini-4-argon</code>, status Stable (GA); the official model page states &ldquo;Latest update: October 2026&rdquo;.<br><strong>Positioning</strong>: built for complex software engineering, hard maths and science, autonomous multi-step agents and long decode.<span class=\\\"tl-price-badge\\\">$2.00 / $10.00 (through 11/30, cache $0.10)</span>\"\n   },\n   \"shown_on\": [\n    \"pricing\",\n    \"timeline\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://ai.google.dev/gemini-api/docs/models/gemini-4-argon\",\n     \"fetched_at\": null,\n     \"quote\": null\n    },\n    {\n     \"url\": \"https://ai.google.dev/gemini-api/docs/changelog\",\n     \"fetched_at\": \"2026-11-21\",\n     \"quote\": null\n    }\n   ],\n   \"events\": []\n  },\n  \"meta-muse-wonder\": {\n   \"id\": \"meta-muse-wonder\",\n   \"provider\": \"Meta\",\n   \"provider_class\": \"dot-meta\",\n   \"names\": {\n    \"ja\": \"Meta Muse Wonder / Muse Wonder Full\",\n    \"en\": \"Meta launches Muse Wonder / Muse Wonder Full\"\n   },\n   \"released\": \"2026-10-12\",\n   \"status\": \"unknown\",\n   \"price\": {\n    \"name\": \"Meta Muse Wonder\",\n    \"input\": 4.0,\n    \"output\": 20.0,\n    \"note_ja\": \"2026-10-12公開（muse-wonder-1.0）。キャッシュ入力 $0.20、1Mコンテキスト、長文プレミアムなし。Contributor モードの提供なし\",\n    \"note_en\": \"Released 2026-10-12 (muse-wonder-1.0). $0.20 cache input, 1M context, no long-context surcharge, no Contributor mode\",\n    \"label\": \"Muse Wonder\",\n    \"provider\": \"other\"\n   },\n   \"timeline\": {\n    \"ja_id\": \"meta-muse-wonder\",\n    \"en_id\": \"meta-muse-wonder\",\n    \"title_ja\": \"Meta Muse Wonder / Muse Wonder Full 公開 — Metaがエージェント特化のフロンティアモデルで本格参入\",\n    \"title_en\": \"Meta launches Muse Wonder / Muse Wonder Full — its agent-first frontier models\",\n    \"desc_ja\": \"<strong>料金</strong>: <code>muse-wonder-1.0</code> は入力$4.00・キャッシュ入力$0.20・出力$20.00（USD/1M）。<strong>長文プレミアムなし</strong>（コンテキストの埋まり具合で単価は変わらない）・Contributorモードの提供なし。Web検索グラウンディングは$2.50/1,000クエリの別建て。<br><strong>仕様</strong>: 1Mコンテキスト。長時間走るエージェント、サブエージェントへの委譲、高度なコンピュータ操作（ブラウザ・デスクトップ・モバイル）向け。<br><strong>上位モデル</strong>: Muse Wonder Full はトークン従量ではなく Muse Code サブスク限定（Power $50/月・Maximum $200/月）。Muse Code の通常プランで使う <code>muse-spark-1.3 / 1.2 / 1.1</code> は入力$1.25・キャッシュ入力$0.15・出力$4.25（Contributorモードは$0.10/$0.002/$0.20、Spark 1.1はStandardのみ）。<span class=\\\"tl-price-badge\\\">$4.00 / $0.20 / $20.00</span>\",\n    \"desc_en\": \"<strong>Pricing</strong>: <code>muse-wonder-1.0</code> is $4.00 input / $0.20 cached input / $20.00 output per 1M tokens. <strong>No long-context premium</strong> (rate is flat whether the window is nearly empty or nearly full) and no Contributor mode. Web search grounding is billed separately at $2.50 per 1,000 queries.<br><strong>Specs</strong>: 1M context, built for long-running agents, sub-agent delegation and advanced computer use (browser, desktop, mobile).<br><strong>Tier above</strong>: Muse Wonder Full is not token-priced; it ships by subscription in Muse Code (Power $50/mo, Maximum $200/mo). Muse Code plans also serve <code>muse-spark-1.3 / 1.2 / 1.1</code> at $1.25 input / $0.15 cached / $4.25 output (Contributor mode $0.10 / $0.002 / $0.20; Spark 1.1 is Standard mode only).<span class=\\\"tl-price-badge\\\">$4.00 / $0.20 / $20.00</span>\"\n   },\n   \"shown_on\": [\n    \"calculator\",\n    \"pricing\",\n    \"timeline\"\n   ],\n   \"sources\": [\n    {\n     \"url\": \"https://dev.meta.ai/models/muse-wonder\",\n     \"fetched_at\": null,\n     \