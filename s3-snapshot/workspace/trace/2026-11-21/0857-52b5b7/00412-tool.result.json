shell {"status": "success", "content": [{"text": "Execution Summary:\nTotal commands: 1\nSuccessful: 1\nFailed: 0"}, {"text": "Command: cd /tmp/site && python3 - <<'PYEOF'\nimport re, pathlib\n\nSTATES = {'ja': ('状態','現行','旧版'), 'en': ('Status','Current','Legacy')}\n\ndef fix(rel, lang):\n    hdr, cur_v, old_v = STATES[lang]\n    p = pathlib.Path(rel); s = p.read_text(encoding='utf-8')\n    stray = re.compile(r'<td>(%s|%s|%s|%s)</td>' % (cur_v, old_v, '現行', 'Current'))\n    def tbl(m):\n        t = m.group(0)\n        if 'class=\"model-name\">kimi-k3.1-pro' not in t:\n            return t\n        th_end = t.find('</thead>')\n        if th_end < 0: return t\n        thead, rest = t[:th_end], t[th_end:]\n        # 1) thead に紛れ込んだ <td> を取り除く（不正HTML）\n        thead = stray.sub('', thead)\n        # 2) 状態列の見出しを1つだけ持たせる\n        if '<th>%s</th>' % hdr not in thead:\n            thead = thead.replace('</tr>', '<th>%s</th></tr>' % hdr, 1)\n        # 3) tbody の各行：既存の状態セルを外して正しい値を1つだけ付ける\n        body_end = rest.find('</table>')\n        body, tail = rest[:body_end], rest[body_end:]\n        def row(rm):\n            r = stray.sub('', rm.group(0))\n            v = old_v if ('前世代' in r or 'previous generation' in r) else cur_v\n            return r[:-len('</tr>')] + '<td>%s</td></tr>' % v\n        body = re.sub(r'<tr>.*?</tr>', row, body, flags=re.S)\n        return thead + body + tail\n    out = re.sub(r'<table>.*?</table>', tbl, s, flags=re.S)\n    if out != s:\n        p.write_text(out, encoding='utf-8')\n    return out\n\nfor rel, lang in (('kimi-k3-1-pro/index.html','ja'), ('en/kimi-k3-1-pro/index.html','en')):\n    out = fix(rel, lang)\n    hdr = STATES[lang][0]\n    print(\"--- %s\" % rel)\n    print(\"   thead 状態列: %d / td-in-thead残留: %d\"\n          % (len(re.findall(r'<th>%s</th>' % hdr, out)),\n             len(re.findall(r'</th><td>', out))))\n    for th in re.findall(r'<thead>.*?</thead>', out):\n        if 'model-name' not in th and 'kimi' in out[:1]: pass\n    # モデル表2つの見出し\n    for h in re.findall(r'<thead><tr>(?:(?!</tr>).)*</tr></thead>', out):\n        if 'Status' in h or '状態' in h: print(\"   thead:\", re.sub('<[^>]+>','|',h)[:110])\n    print(\"   現行/Current:\", len(re.findall(r'<td>%s</td>' % STATES[lang][1], out)),\n          \" 旧版/Legacy:\", len(re.findall(r'<td>%s</td>' % STATES[lang][2], out)))\nPYEOF\nStatus: success\nExit Code: 0\nOutput: --- kimi-k3-1-pro/index.html\r\n   thead 状態列: 2 / td-in-thead残留: 0\r\n   thead: |||モデル||入力||出力||キャッシュヒット入力||キャッシュ書込（5分）||キャッシュ書込（1時間）||状態|||\r\n   thead: |||モデル||入力||出力||キャッシュヒット入力||キャッシュ書込（5min）||キャッシュ書込（1h）||状態|||\r\n   現行/Current: 4  旧版/Legacy: 2\r\n--- en/kimi-k3-1-pro/index.html\r\n   thead 状態列: 2 / td-in-thead残留: 0\r\n   thead: |||Model||Input||Output||Cached input||5m writes||1h writes||Status|||\r\n   thead: |||Model||Input||Output||Cached input||5m writes||1h writes||Status|||\r\n   現行/Current: 4  旧版/Legacy: 2\r\n\nError: "}], "toolUseId": "call_00_omo427HJkEF1xEFtXbbg9762"}