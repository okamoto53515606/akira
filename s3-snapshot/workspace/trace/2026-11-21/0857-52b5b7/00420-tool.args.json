shell {"command": "cd /tmp/site && echo \"=== precise 新フラッグシップ (excl 最新) BEFORE ===\" && python3 -c \"\nimport pathlib,re\nfor p in sorted(pathlib.Path('.').rglob('*.html')):\n    s=p.read_text(encoding='utf-8')\n    for m in re.finditer(r'(?<!最)新フラッグシップ',s):\n        ln=s[:m.start()].count(chr(10))+1\n        print('%-42s L%-4d %s'%(p,ln,s[max(0,m.start()-55):m.start()+45].replace(chr(10),' ')))\n\"\necho \"=== apply parity + multimodal strong ===\" && python3 - <<'PYEOF'\nimport json,re,pathlib\nWS=pathlib.Path('/workspace'); SITE=pathlib.Path('/tmp/site')\n# 1) multimodal: 現行モデルの強調を表の作法(<strong>)に寄せる（facts 経由 = render で保持）\nfp=WS/'data'/'facts.json'; f=json.loads(fp.read_text(encoding='utf-8'))\nn=0\nfor slug,rec in (f.get('features') or {}).items():\n    for b in rec.get('blocks') or []:\n        for lang in ('ja','en'):\n            body=(b.get('body') or {}).get(lang)\n            if body and 'Gemini Nano Banana 2.1<br>' in body:\n                b['body'][lang]=body.replace('Gemini Nano Banana 2.1<br>','<strong>Gemini Nano Banana 2.1</strong><br>'); n+=1\nfp.write_text(json.dumps(f,ensure_ascii=False,indent=1),encoding='utf-8')\nprint('multimodal <strong>:',n)\n\n# 2) ja/en パリティ（en で落としたラベルの ja 側を残さない）\ndef patch(rel,pairs):\n    p=SITE/rel; s=p.read_text(encoding='utf-8')\n    for old,new,exp in pairs:\n        c=s.count(old)\n        print('  %-34s %-28s %d/%d'%(rel,old[:26],c,exp))\n        s=s.replace(old,new)\n    p.write_text(s,encoding='utf-8')\npatch('gpt-6/index.html',[('✨ 新フラッグシップ — ','✨ フラッグシップ — ',1),\n                          ('新フラッグシップ（基準）','フラッグシップ（基準）',1)])\npatch('claude-fable-5-1/index.html',[('Anthropic新フラッグシップ（Mythosクラス）','Anthropicのフラッグシップ（Mythosクラス）',3),\n                                     ('新フラッグシップ（Mythosクラス）','フラッグシップ（Mythosクラス）',1)])\nPYEOF"}