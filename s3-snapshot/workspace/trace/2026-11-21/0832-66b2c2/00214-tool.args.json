shell {"command": "cd /workspace && mkdir -p notes/backup-20261121 && cp data/facts.json notes/backup-20261121/facts.json && cp tools/render_site.py notes/backup-20261121/render_site.py && python3 - <<'PY'\nimport json, pathlib, re\n\n# --- 1. 台帳（facts.json）: claude-fable-5-2 ---\np = pathlib.Path('data/facts.json')\nd = json.loads(p.read_text(encoding='utf-8'))\nr = d['models']['claude-fable-5-2']\nbefore = (r['price'].get('provider'), r['names']['ja'], r['names']['en'])\nr['price']['provider'] = 'anthropic'                 # 表示名 \"Anthropic\" → slug\nr['names']['ja'] = 'Claude Fable 5.2'                # price.name と一致させる（C5 は names で照合）\nr['names']['en'] = 'Claude Fable 5.2'\nprint('ledger before:', before)\nprint('ledger after :', (r['price']['provider'], r['names']['ja'], r['names']['en']))\np.write_text(json.dumps(d, ensure_ascii=False, indent=1), encoding='utf-8')\n\n# --- 2. 生成器（render_site.py）: provider を slug に正規化 ---\nq = pathlib.Path('tools/render_site.py')\ns = q.read_text(encoding='utf-8')\nold = '''def render_models_json(site: Path, facts: dict) -> bool:\n    path = site / \"data\" / \"models.json\"\n    cur = json.loads(path.read_text(encoding=\"utf-8\"))\n    rows = cur.get(\"models\", [])\n    have = {r[\"name\"] for r in rows}\n    add = []\n'''\nnew = '''PROVIDER_SLUGS = (\"anthropic\", \"openai\", \"google\", \"deepseek\")\n\n\ndef provider_slug(value) -> str:\n    \"\"\"provider を計算機の slug に揃える（表示名 \"Anthropic\" -> \"anthropic\"）。\n\n    2026-11-21: 台帳の price.provider に表示名が入り、data/models.json だけ\n    大文字始まりになって公開契約チェックが「台帳はGAだが計算機に無い」と\n    誤判定した。既存行も含めて slug に寄せる。未知の provider（\"Meta\" /\n    \"alibaba\" など）は表示色のクラスが変わるため触らない。\n    \"\"\"\n    v = str(value or \"\").strip()\n    if not v:\n        return \"other\"\n    low = v.lower()\n    return low if low in PROVIDER_SLUGS else v\n\n\ndef render_models_json(site: Path, facts: dict) -> bool:\n    path = site / \"data\" / \"models.json\"\n    cur = json.loads(path.read_text(encoding=\"utf-8\"))\n    rows = cur.get(\"models\", [])\n    have = {r[\"name\"] for r in rows}\n    changed = False\n    for r in rows:                      # 既存行の provider 表記を揃える\n        slug = provider_slug(r.get(\"provider\"))\n        if r.get(\"provider\") != slug:\n            r[\"provider\"] = slug\n            changed = True\n    add = []\n'''\nassert old in s\ns = s.replace(old, new, 1)\n\nold2 = '''            \"provider\": p.get(\"provider\") or \"other\",'''\nnew2 = '''            \"provider\": provider_slug(p.get(\"provider\")),'''\nassert old2 in s\ns = s.replace(old2, new2, 1)\n\nold3 = '''    if not add:\n        return False\n    cur[\"models\"] = add + rows\n    cur[\"updated\"] = TODAY'''\nnew3 = '''    if not add and not changed:\n        return False\n    if add:\n        cur[\"models\"] = add + rows\n    cur[\"updated\"] = TODAY'''\nassert old3 in s\ns = s.replace(old3, new3, 1)\nq.write_text(s, encoding='utf-8')\nprint('render_site.py patched')\nPY\ngrep -n \"provider_slug\\|if not add\" tools/render_site.py | head"}