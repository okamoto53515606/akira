shell {"command": "echo \"=== /tmp/site exists? ===\"; ls -d /tmp/site 2>&1; echo \"=== count ===\"; find /tmp/site -type f 2>/dev/null | wc -l; echo \"=== pricing exists? ===\"; ls -la /tmp/site/pricing/index.html 2>&1; echo \"=== newest files ===\"; find /tmp/site -type f -newermt '-3 days' 2>/dev/null | head -20; echo \"=== grep variants ===\"; grep -rc 'bold yellow' /tmp/site 2>/dev/null | grep -v ':0' | head; echo \"(bold yellow total)\"; grep -ro 'bold yellow' /tmp/site 2>/dev/null | wc -l"}