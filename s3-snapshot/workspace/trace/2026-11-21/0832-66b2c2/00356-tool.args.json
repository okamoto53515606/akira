shell {"command": "cd /tmp/site\necho \"=== 1) render 後 md5 差分（changed 0 の裏取り） ===\"\nfind . -type f \\( -name '*.html' -o -name '*.css' -o -name '*.json' -o -name '*.xml' \\) -print0 | xargs -0 md5sum | sort -k2 > /tmp/after1.md5\ndiff /tmp/before.md5 /tmp/after1.md5 && echo \"DIFF: 0行（完全一致）\"\necho\necho \"=== 2) render 後の [bold 全数 ===\"\ngrep -ro '\\[bold' . 2>/dev/null | wc -l\necho\necho \"=== 3) 既存ゲートに『装飾マークアップ漏れ』検出があるか ===\"\ngrep -rn '\\[bold\\|bold yellow\\|markup\\|leak' /workspace/tools/*.py | grep -v '^.*render_site' | head -10\necho \"--- check_site_pages の検査項目一覧 ---\"\ngrep -n 'def check_\\|ERROR\\]' /workspace/tools/check_site_pages.py | head -30\necho\necho \"=== 4) 公開物とローカルの一致（pricing） ===\"\ncurl -sS https://llm.okamomedia.tokyo/pricing/ | md5sum\nmd5sum pricing/index.html"}