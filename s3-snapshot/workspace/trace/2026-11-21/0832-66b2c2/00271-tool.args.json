shell {"command": "curl -s https://llm.okamomedia.tokyo/data/models.json | python3 -c \"\nimport json,sys\nd=json.load(sys.stdin); rows=d['models']\nprint('updated', d.get('updated'), 'rows', len(rows))\nprint('neon:', [(r['name'],r['provider'],r['input'],r['output']) for r in rows if 'Neon' in r['name']])\nprint('fable:', [(r['name'],r['provider']) for r in rows if r['name'].startswith('Claude Fable 5.2')])\nimport re\nbad=[r['name'] for r in rows if re.search(r'\\[/?(bold|yellow|red|green)', r['name']+r.get('note',''))]\nprint('decorated:', bad)\n\""}