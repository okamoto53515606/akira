shell {"command": "cd /tmp/site\necho \"=== 1) ローカル最終 grep（走査対象 / ヒット件数）===\"\necho -n \"対象ファイル数(html/css/js/json): \"; find . -type f \\( -name '*.html' -o -name '*.css' -o -name '*.js' -o -name '*.json' \\) | wc -l\necho -n \"[bold 全数(/tmp/site 全体): \"; grep -ro '\\[bold' . | wc -l\necho -n \"[bold yellow 全数          : \"; grep -ro 'bold yellow' . | wc -l\necho -n \"[bold (html/css/json のみ) : \"; grep -r '\\[bold' --include='*.html' --include='*.css' --include='*.json' . | wc -l\necho\necho \"=== 2) 公開URLの実取得（curl・修正後）===\"\nfor u in pricing/ china-ai/ en/pricing/ en/china-ai/; do\n  f=\"/tmp/live_$(echo $u | tr '/' '_').html\"\n  code=$(curl -sS -o \"$f\" -w '%{http_code}' -H 'Cache-Control: no-cache' \"https://llm.okamomedia.tokyo/$u\")\n  b=$(wc -c < \"$f\"); h=$(grep -c '\\[bold' \"$f\"); hy=$(grep -o 'bold yellow' \"$f\" | wc -l)\n  echo \"/$u  HTTP=$code  bytes=$b  '[bold'=$h  'bold yellow'=$hy\"\ndone\necho\necho \"=== 3) プロバイダ色ドットの円形化（公開 /pricing/ の実物）===\"\ngrep -o '\\.provider-dot{[^}]*}' /tmp/live_pricing_.html\necho -n \"border-radius:50% の出現回数: \"; grep -o 'border-radius:50%' /tmp/live_pricing_.html | wc -l\necho -n \"壊れた角括弧入りborder-radius: \"; grep -o 'border-radius:\\[[^;]*' /tmp/live_pricing_.html | wc -l\necho\necho \"=== 4) 新ゲートの構文・配置 ===\"\npython3 -m py_compile /workspace/tools/check_markup_leak.py && echo \"check_markup_leak.py: compile OK\"\npython3 -m py_compile /workspace/tools/self_check.py && echo \"self_check.py: compile OK\"\ngrep -n 'markup_leak' /workspace/tools/self_check.py"}