shell {"command": "cd /workspace/tools && python3 - <<'PY'\nimport re, io\np='check_markup_leak.py'\ns=open(p,encoding='utf-8').read()\n\nold_scan = s[s.index('def _scan_css_text'):s.index('def _iter_files')]\nnew_scan = '''STYLE_BLOCK_RE = re.compile(r\"<style[^>]*>(.*?)</style>\", re.IGNORECASE | re.DOTALL)\n\n\ndef _css_regions(text: str, suffix: str):\n    \"\"\"CSS として解釈してよい領域だけを返す（HTML の属性を CSS 宣言と誤認しないため）。\n\n    .css は全文、.html は <style> ブロックのみ。\n    \"\"\"\n    if suffix == \".css\":\n        return [text]\n    return STYLE_BLOCK_RE.findall(text)\n\n\ndef _scan_css_text(text: str):\n    \"\"\"CSS 断片から「値に [ または ] を含む宣言」を返す。\"\"\"\n    out = []\n    for m in DECL_RE.finditer(text):\n        prop, value = m.group(1), m.group(2)\n        if \"[\" not in value and \"]\" not in value:\n            continue\n        v = value.strip()\n        # HTML 属性や content:\"[\" のような正当例は値に引用符/山括弧が入るので除外\n        if any(ch in v for ch in ('\"', \"'\", \"<\", \">\")):\n            continue\n        if len(v) > 120:\n            continue\n        out.append((prop, v[:100]))\n    return out\n\n\n'''\ns = s.replace(old_scan, new_scan)\n\n# 呼び出し側: style ブロック/.css のみを走査\ns = s.replace('''        for prop, value in _scan_css_text(text):''',\n              '''        css_hits_in_file = []\n        for region in _css_regions(text, path.suffix.lower()):\n            css_hits_in_file.extend(_scan_css_text(region))\n\n        for prop, value in css_hits_in_file:''')\n\nopen(p,'w',encoding='utf-8').write(s)\nprint(\"patched\")\nPY\necho \"=== 再検証 1) 実サイト ===\"\npython3 /workspace/tools/check_markup_leak.py /tmp/site; echo \"exit=$?\"\necho \"=== 再検証 2) フィクスチャ（検出できること） ===\"\npython3 /workspace/tools/check_markup_leak.py /tmp/fixture | tail -4; echo \"exit=$?\"\necho \"=== 再検証 3) css 実ファイルの破壊も拾えるか ===\"\nmkdir -p /tmp/fixture2 && printf '.provider-dot{width:10px;height:10px;border-radius:[bold yellow]50%%[/bold yellow];}\\n' > /tmp/fixture2/a.css\npython3 /workspace/tools/check_markup_leak.p