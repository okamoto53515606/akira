shell {"command": "echo \"=== A) サイト外も含めた広域走査（[bold / bold yellow） ===\"\nfor d in /tmp /workspace /root /home /var/www; do\n  [ -d \"$d\" ] || continue\n  c=$(grep -rl '\\[bold' \"$d\" 2>/dev/null | wc -l)\n  echo \"$d : files_with_[bold = $c\"\ndone\necho\necho \"--- 該当ファイル（/tmp /workspace 限定・上位20） ---\"\ngrep -rl 'bold yellow' /tmp /workspace 2>/dev/null | head -20\necho\necho \"=== B) /tmp/site の '[a-z]* ' 2件の中身 ===\"\ngrep -rn '\\[[a-z]* ' /tmp/site 2>/dev/null | head -5\necho\necho \"=== C) GLM/Permanent 表記の現状（$0.60／$2.40 周辺） ===\"\ngrep -rn 'Permanent' /tmp/site --include='*.html' 2>/dev/null | head -5\necho \"--- glm-5-3-flash の沿革に [bold 相当があるか ---\"\nls /tmp/site/glm-5-3-flash/ 2>/dev/null; grep -c 'strong' /tmp/site/glm-5-3-flash/index.html 2>/dev/null\necho\necho \"=== D) china-ai lab-card / 料金表 ===\"\ngrep -c 'lab-card' /tmp/site/china-ai/index.html 2>/dev/null\necho\necho \"=== E) 生成器 render_site.py に一括置換の痕跡がないか ===\"\ngrep -n 'bold yellow\\|\\[bold\\|replace(' /workspace/tools/render_site.py | head -20"}