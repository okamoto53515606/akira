shell {"command": "cd /tmp/site\necho \"=== A) LOCAL: 各種マークアップ片の全数 ===\"\nfor p in '\\[bold' '\\[/bold' 'bold yellow' '\\[/yellow\\]' '\\[yellow\\]' '\\[red\\]' '\\[[a-z]* ' ; do\n  n=$(grep -ro \"$p\" . 2>/dev/null | wc -l); echo \"pattern '$p' -> $n\";\ndone\necho\necho \"=== B) LOCAL: html/css/json 限定の [bold ===\"\ngrep -r '\\[bold' --include='*.html' --include='*.css' --include='*.json' . 2>/dev/null | wc -l\necho\necho \"=== C) facts.json (台帳) 内の [bold ===\"\ngrep -o '\\[bold' /workspace/data/facts.json 2>/dev/null | wc -l\ngrep -o 'bold yellow' /workspace/data/facts.json 2>/dev/null | wc -l\necho\necho \"=== D) LIVE URL 実取得 (curl) ===\"\nfor u in pricing/ china-ai/ en/pricing/ en/china-ai/; do\n  body=$(curl -sS -H 'Cache-Control: no-cache' \"https://llm.okamomedia.tokyo/$u\")\n  bytes=$(printf '%s' \"$body\" | wc -c)\n  hits=$(printf '%s' \"$body\" | grep -o '\\[bold' | wc -l)\n  hits2=$(printf '%s' \"$body\" | grep -o 'bold yellow' | wc -l)\n  code=$(curl -sS -o /dev/null -w '%{http_code}' \"https://llm.okamomedia.tokyo/$u\")\n  echo \"/$u HTTP=$code bytes=$bytes  '[bold'=$hits  'bold yellow'=$hits2\"\ndone\necho\necho \"=== E) LIVE pricing の border-radius:50% 確認 ===\"\ncurl -sS https://llm.okamomedia.tokyo/pricing/ | grep -o 'border-radius:[^;}]*' | sort | uniq -c"}