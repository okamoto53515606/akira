shell {"command": "cd /tmp/site\necho \"=== 前スナップショット ===\"\nfind . -type f \\( -name '*.html' -o -name '*.css' -o -name '*.json' -o -name '*.xml' \\) -print0 | xargs -0 md5sum | sort -k2 > /tmp/before.md5\nwc -l < /tmp/before.md5\necho \"=== pricing/index.html の30行目付近（実物） ===\"\nsed -n '28,32p' pricing/index.html | cut -c1-260\necho \"=== /root の [bold 41件は何か（サイトと無関係か確認） ===\"\ngrep -rl '\\[bold' /root 2>/dev/null | head -5\ngrep -rl '\\[bold' /root 2>/dev/null | sed 's|.*/||' | sort | uniq -c | sort -rn | head -5"}