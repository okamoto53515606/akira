shell {"command": "cd /workspace && rm -rf /tmp/sc3 && mkdir -p /tmp/sc3 && cp -a /tmp/site /tmp/sc3/site && python3 -c \"\nimport importlib.util, pathlib, json\nspec=importlib.util.spec_from_file_location('m','/workspace/tools/render_site.py')\nm=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\nprint('changed', m.run(pathlib.Path('/tmp/sc3/site'), pathlib.Path('/workspace')))\nrows=json.load(open('/tmp/sc3/site/data/models.json'))['models']\nprint([r['provider'] for r in rows if r['name']=='Claude Fable 5.2'])\n\"; echo \"=== run() body models ===\"; grep -n \"models.json\\|render_models_json\" /workspace/tools/render_site.py | head"}